diff --git a/src/apprt/gtk/css/style.css b/src/apprt/gtk/css/style.css
index 9c0f115..ff3fb43 100644
--- a/src/apprt/gtk/css/style.css
+++ b/src/apprt/gtk/css/style.css
@@ -181,3 +181,116 @@ label.resize-overlay {
   margin: 0;
   padding: 0;
 }
+
+/*
+ * GhosttyTabSidebar
+ *
+ * The sidebar is an Adw.Bin sitting in a GtkOverlay above the terminal, and a
+ * plain Bin draws no background of its own. Without an explicit one the tab
+ * rows render straight over terminal output as soon as the sidebar expands.
+ *
+ * Each color is declared twice on purpose. libadwaita's `@define-color` names
+ * live in its own style provider and are NOT visible from ours, so
+ * `@sidebar_bg_color` parses as invalid here and the declaration is dropped
+ * entirely -- leaving the sidebar with no background at all. Its CSS
+ * *variables* do cross providers, but only on GTK 4.16 and later. So: a
+ * literal first, which always parses, then the variable, which overrides it
+ * wherever it is supported.
+ */
+.ghostty-tab-sidebar {
+  background-color: #ebebed;
+  background-color: var(--sidebar-bg-color);
+  color: var(--sidebar-fg-color);
+
+  /* Deliberately square and full height, separated from the terminal by a
+   * hairline on the facing edge. This is libadwaita's own sidebar convention
+   * -- its stylesheet draws sidebar edges with an inset box-shadow in
+   * --sidebar-border-color and never rounds a sidebar's outer corners.
+   * Rounding them made the rail read as a card floating on the terminal
+   * rather than part of the window. */
+  box-shadow: inset -1px 0 var(--sidebar-border-color);
+}
+
+.ghostty-tab-sidebar.sidebar-right {
+  box-shadow: inset 1px 0 var(--sidebar-border-color);
+}
+
+.ghostty-tab-sidebar list {
+  background-color: transparent;
+}
+
+/*
+ * Rows. Expanded these are ordinary full-width list rows; collapsed they
+ * become centered square chips. Without this the row keeps its full expanded
+ * width and the rail simply clips it, so every tab reads as a slab running
+ * off the edge instead of a button.
+ *
+ * 7px side margins on a 46px rail leave a 32px chip whose center lands on the
+ * same axis as the icon's own indent, so nothing shifts between states.
+ */
+.ghostty-tab-sidebar listview > row {
+  padding: 0;
+  margin: 1px 7px;
+  border-radius: 8px;
+  min-height: 0;
+}
+
+.ghostty-tab-sidebar.collapsed listview > row {
+  margin: 2px 7px;
+  min-height: 32px;
+  border-radius: 10px;
+}
+
+/* Same treatment for the pinned "New Tab" button, so it sits in the column
+ * rather than floating above it. The 7px side margins are the only thing
+ * centering either one: 46 - 32 = 14, split evenly. Nothing else may add an
+ * indent, or the content exceeds the rail and pushes it over the terminal. */
+.ghostty-tab-sidebar button.flat {
+  padding: 0;
+  margin: 6px 7px 2px;
+  border-radius: 8px;
+  min-height: 32px;
+}
+
+.ghostty-tab-sidebar.collapsed button.flat {
+  border-radius: 10px;
+}
+
+/* Expanded, the panel genuinely does float over the terminal, so it keeps the
+ * hairline and gains a shadow to say so. Collapsed it has neither. */
+.ghostty-tab-sidebar:not(.collapsed) {
+  box-shadow: inset -1px 0 var(--sidebar-border-color),
+              0 0 12px 0 var(--sidebar-shade-color);
+}
+
+.ghostty-tab-sidebar.sidebar-right:not(.collapsed) {
+  box-shadow: inset 1px 0 var(--sidebar-border-color),
+              0 0 12px 0 var(--sidebar-shade-color);
+}
+
+/* Selection: a filled rounded square behind the icon. alpha() rather than a
+ * literal so it tracks the foreground colour in both themes. */
+.ghostty-tab-sidebar listview > row:selected {
+  background-color: alpha(currentColor, 0.10);
+}
+
+.ghostty-tab-sidebar listview > row:hover {
+  background-color: alpha(currentColor, 0.05);
+}
+
+/*
+ * Scrim covering the terminal while the sidebar is expanded, from the
+ * sidebar's inner edge to the far side of the window. It is a sibling overlay
+ * drawn *under* the sidebar, so the sidebar's own area stays undimmed.
+ *
+ * can-target=false in the blueprint keeps it from swallowing clicks meant for
+ * the terminal underneath.
+ */
+.ghostty-tab-sidebar-dim {
+  background-color: transparent;
+  transition: background-color 180ms ease;
+}
+
+.ghostty-tab-sidebar-dim.active {
+  background-color: rgba(0, 0, 0, 0.35);
+}
diff --git a/src/apprt/gtk/ui/1.5/tab-sidebar.blp b/src/apprt/gtk/ui/1.5/tab-sidebar.blp
new file mode 100644
index 0000000..49247b7
--- /dev/null
+++ b/src/apprt/gtk/ui/1.5/tab-sidebar.blp
@@ -0,0 +1,192 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $GhosttyTabSidebar: Adw.Bin {
+  styles [
+    "ghostty-tab-sidebar",
+  ]
+
+  Gtk.Box {
+    orientation: vertical;
+
+    // The top row: "New Tab" plus the two buttons Ghostty puts in its
+    // titlebar. Declared before the list and outside the ScrolledWindow, so
+    // the whole row stays pinned while the tabs scroll beneath it.
+    //
+    // Collapsed, only the "+" is shown and it occupies the whole rail. As the
+    // sidebar opens the other two fade in and the "+" gives up the width to
+    // make room, so the row grows into the space rather than rearranging.
+    Gtk.Box top_bar {
+      orientation: horizontal;
+      spacing: 0;
+
+      // Visibility is driven from Zig by `gtk-tabs-sidebar-new-button`.
+      Gtk.Button new_tab_button {
+        clicked => $new_tab_clicked();
+        can-focus: false;
+        focus-on-click: false;
+        hexpand: true;
+
+        styles [
+          "flat",
+        ]
+
+        // Deliberately a Box rather than Adw.ButtonContent: the label has to
+        // fade out entirely in rail mode, and ButtonContent gives no way to
+        // address its label on its own.
+        //
+        // No margin here -- the button's own margins in CSS centre it in the
+        // rail. The fixed 32px square must match TabSidebar.icon_chip:
+        // symbolic icons differ in natural width, so aligning on the box
+        // rather than the glyph is what keeps the "+" in line with the tab
+        // icons below.
+        // margin-start is measured, not derived. The button spans the full
+        // sidebar width while GtkListView insets its rows, so without this
+        // the "+" sits left of every tab icon. If rail_width or the row
+        // margins change, re-measure rather than recompute.
+        child: Gtk.Box {
+          orientation: horizontal;
+          spacing: 6;
+          halign: start;
+          margin-start: 4;
+
+          Gtk.Image {
+            icon-name: "tab-new-symbolic";
+            width-request: 32;
+            height-request: 32;
+          }
+
+          Gtk.Label new_tab_label {
+            label: _("New Tab");
+          }
+        };
+      }
+
+      // Both drive window actions rather than property bindings: the header
+      // bar can bind straight to tab_overview because it lives in the
+      // window's own template, but the sidebar is a separate class and
+      // cannot see it, so the overview toggle goes through
+      // win.toggle-tab-overview.
+      Gtk.Button overview_button {
+        action-name: "win.toggle-tab-overview";
+        icon-name: "view-grid-symbolic";
+        tooltip-text: _("View Open Tabs");
+        can-focus: false;
+        focus-on-click: false;
+
+        styles [
+          "flat",
+        ]
+      }
+
+      Gtk.MenuButton menu_button {
+        icon-name: "open-menu-symbolic";
+        menu-model: sidebar_menu;
+        tooltip-text: _("Main Menu");
+        can-focus: false;
+
+        styles [
+          "flat",
+        ]
+      }
+    }
+
+    // propagate-natural-width and overlay-scrolling both matter: without
+    // them the vertical scrollbar reserves layout width once there are
+    // enough tabs to scroll, making the rail wider than rail_width while the
+    // terminal's inset stays put -- so the rail creeps over the terminal.
+    Gtk.ScrolledWindow {
+      vexpand: true;
+      hscrollbar-policy: never;
+      propagate-natural-width: false;
+      overlay-scrolling: true;
+      min-content-width: 0;
+
+      // The model and factory are both installed from Zig. The model is the
+      // GtkSelectionModel that AdwTabView already maintains for its pages, so
+      // selection stays in sync with the tab view in both directions without
+      // any bookkeeping on our side.
+      //
+      // Not focusable on purpose: keyboard focus must stay in the terminal
+      // when you click a tab, the same way Ghostty's toolbar buttons set
+      // can-focus=false. Otherwise clicking the sidebar leaves you typing
+      // into a list instead of the shell.
+      //
+      // single-click-activate is deliberately left off: GTK documents it as
+      // "activate rows on single click and select them on hover", and the
+      // hover half of that would switch tabs just by moving the pointer.
+      Gtk.ListView list_view {
+        focusable: false;
+
+        styles [
+          "navigation-sidebar",
+        ]
+      }
+    }
+
+  }
+}
+
+// The sidebar's own menu. Every entry targets an existing win.* or app.*
+// action, which resolve up the widget hierarchy to the window and
+// application, so nothing here reimplements behaviour.
+menu sidebar_menu {
+  section {
+    item {
+      label: _("New Tab");
+      action: "win.new-tab";
+    }
+
+    item {
+      label: _("Change Tab Title…");
+      action: "win.prompt-tab-title";
+    }
+
+    item {
+      label: _("Close Tab");
+      action: "win.close-tab";
+      target: "this";
+    }
+  }
+
+  section {
+    item {
+      label: _("View Open Tabs");
+      action: "win.toggle-tab-overview";
+    }
+
+    item {
+      label: _("Command Palette");
+      action: "win.toggle-command-palette";
+    }
+  }
+
+  // The sidebar's own settings -- width, animation timing, which side it
+  // sits on -- are config values, and Ghostty never writes its own config
+  // file, so the honest entry point is to open it.
+  section {
+    label: _("Sidebar");
+
+    item {
+      label: _("Open Configuration");
+      action: "app.open-config";
+    }
+
+    item {
+      label: _("Reload Configuration");
+      action: "app.reload-config";
+    }
+  }
+
+  section {
+    item {
+      label: _("New Window");
+      action: "win.new-window";
+    }
+
+    item {
+      label: _("About Ghostty");
+      action: "win.about";
+    }
+  }
+}
