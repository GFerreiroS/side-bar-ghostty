+    }
+
+    fn rowCloseClicked(button: *gtk.Button, self: *Self) callconv(.c) void {
+        self.closePageData(button.as(gobject.Object));
+    }
+
+    fn rowMiddleClick(
+        gesture: *gtk.GestureClick,
+        _: c_int,
+        _: f64,
+        _: f64,
+        self: *Self,
+    ) callconv(.c) void {
