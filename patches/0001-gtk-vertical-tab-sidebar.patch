diff --git a/src/apprt/gtk/css/style.css b/src/apprt/gtk/css/style.css
index 9c0f115..67fefcf 100644
--- a/src/apprt/gtk/css/style.css
+++ b/src/apprt/gtk/css/style.css
@@ -181,3 +181,194 @@ label.resize-overlay {
   margin: 0;
   padding: 0;
 }
+
+/*
+ * GhosttyTabSidebar
+ *
+ * The sidebar is an Adw.Bin sitting in a GtkOverlay above the terminal, and a
+ * plain Bin draws no background of its own. Without an explicit one the tab
+ * rows render straight over terminal output as soon as the sidebar expands.
+ *
+ * Each color is declared twice on purpose. libadwaita's `@define-color` names
+ * live in its own style provider and are NOT visible from ours, so
+ * `@sidebar_bg_color` parses as invalid here and the declaration is dropped
+ * entirely -- leaving the sidebar with no background at all. Its CSS
+ * *variables* do cross providers, but only on GTK 4.16 and later. So: a
+ * literal first, which always parses, then the variable, which overrides it
+ * wherever it is supported.
+ */
+.ghostty-tab-sidebar {
+  background-color: #ebebed;
+  background-color: var(--sidebar-bg-color);
+  color: var(--sidebar-fg-color);
+
+  /* Rounded on the edge that faces the terminal, square on the edge that
+   * meets the window frame, in both the rail and the expanded panel. This is
+   * a deliberate departure from libadwaita's sidebar convention, which keeps
+   * outer corners square and separates with a hairline only; asked for
+   * explicitly, on the grounds that the rail should read as its own surface.
+   *
+   * The hairline stays. As an inset shadow it follows the border radius, so
+   * it curves with the corners instead of cutting across them. */
+  border-radius: 0 12px 12px 0;
+  box-shadow: inset -1px 0 var(--sidebar-border-color);
+}
+
+.ghostty-tab-sidebar.sidebar-right {
+  border-radius: 12px 0 0 12px;
+  box-shadow: inset 1px 0 var(--sidebar-border-color);
+}
+
+/*
+ * Everything between the sidebar and its rows must be transparent, or the
+ * sidebar ends up two-toned: its own colour behind the "New Tab" row and the
+ * theme's list colour behind the tabs, with a rounded corner where they meet.
+ *
+ * `list` alone is not enough and never was. That is GtkListBox's CSS node;
+ * GtkListView's is `listview`, so the original rule matched nothing. It went
+ * unnoticed under Adwaita, where the list colour happens to equal the sidebar
+ * colour -- and showed up immediately under a third-party theme (MacTahoe)
+ * where it does not. The scrolled window and viewport paint too, so they are
+ * named here as well rather than waiting for the next theme to prove it.
+ */
+.ghostty-tab-sidebar list,
+.ghostty-tab-sidebar listview,
+.ghostty-tab-sidebar scrolledwindow,
+.ghostty-tab-sidebar viewport {
+  background-color: transparent;
+  background-image: none;
+}
+
+/*
+ * Rows. Expanded these are ordinary full-width list rows; collapsed they
+ * become centered square chips. Without this the row keeps its full expanded
+ * width and the rail simply clips it, so every tab reads as a slab running
+ * off the edge instead of a button.
+ *
+ * 7px side margins on a 46px rail leave a 32px chip whose center lands on the
+ * same axis as the icon's own indent, so nothing shifts between states.
+ */
+.ghostty-tab-sidebar listview > row {
+  padding: 0;
+  /* Vertical only. The horizontal inset is a widget margin, set from Zig, so
+   * that it is identical collapsed and expanded and the icon column does not
+   * shift when the panel opens. A value here would be added to that one. */
+  margin: 1px 0;
+  border-radius: 8px;
+  min-height: 0;
+}
+
+.ghostty-tab-sidebar.collapsed listview > row {
+  /* (rail_width - icon_chip) / 2 = (54 - 32) / 2 = 11, so the chip is a 32px
+   * square on the rail's axis. A row fills the rail's width, so this margin
+   * is what sets the chip's size -- get it wrong and the chip stretches
+   * while the icon stays packed at its start, throwing the glyph off centre. */
+  margin: 2px 11px;
+  min-height: 32px;
+  border-radius: 10px;
+}
+
+/*
+ * The rail's content must be exactly rail_width across. GtkViewport centres
+ * content it cannot fit, so anything wider does not merely clip on the right
+ * -- the whole column slides left and the icons go off-axis. That was the
+ * bug: with Adwaita's navigation-sidebar row geometry in play the content
+ * measured 64px inside a 46px rail, and the icons hung 9px off the left edge
+ * (measured: content box x=-18 w=64, icon centre 14 against a rail centre of
+ * 23). The listview no longer carries that class, so the arithmetic below is
+ * the whole story: 32px chip + 7px each side = 46.
+ *
+ * `!important` on the padding is not decoration. Adwaita's own padding for
+ * these nodes outranks ours in the cascade -- measured, our margins applied
+ * and our padding did not -- and padding here is not cosmetic, it decides
+ * whether the content still fits the rail.
+ */
+
+/* Same treatment for the pinned "New Tab" button, so it sits in the column
+ * rather than floating above it. The 7px side margins are the only thing
+ * centering either one: 46 - 32 = 14, split evenly. Nothing else may add an
+ * indent, or the content exceeds the rail and pushes it over the terminal. */
+.ghostty-tab-sidebar button.flat {
+  /* 1px, not 7px, because a flat button carries 6px of Adwaita padding of
+   * its own that our `padding: 0` does not win against -- measured twice, in
+   * both states. 1 + 6 puts the "+" glyph on exactly the same axis as the
+   * row icons, which start at 7. Re-measure before changing either number;
+   * they are a pair. */
+  /* 5px, against the rows' 11px, because a flat button also carries 6px of
+   * Adwaita padding that our `padding: 0` does not win against (measured in
+   * both states). 5 + 6 = 11 puts the "+" glyph on exactly the same axis as
+   * the row icons. Re-measure before changing either number; they are a
+   * pair, and they both depend on rail_width. */
+  padding: 0;
+  margin: 6px 5px 2px;
+  border-radius: 8px;
+  min-height: 32px;
+}
+
+.ghostty-tab-sidebar.collapsed button.flat {
+  border-radius: 10px;
+}
+
+/* Expanded, the panel genuinely does float over the terminal, so it keeps the
+ * hairline and gains a shadow to say so. Collapsed it has neither. */
+.ghostty-tab-sidebar:not(.collapsed) {
+  box-shadow: inset -1px 0 var(--sidebar-border-color),
+              0 0 12px 0 var(--sidebar-shade-color);
+}
+
+.ghostty-tab-sidebar.sidebar-right:not(.collapsed) {
+  box-shadow: inset 1px 0 var(--sidebar-border-color),
+              0 0 12px 0 var(--sidebar-shade-color);
+}
+
+/* Selection: a filled rounded square behind the icon. alpha() rather than a
+ * literal so it tracks the foreground colour in both themes. */
+.ghostty-tab-sidebar listview > row:selected {
+  background-color: alpha(currentColor, 0.10);
+}
+
+.ghostty-tab-sidebar listview > row:hover {
+  background-color: alpha(currentColor, 0.05);
+}
+
+/*
+ * Second line: branch and subtitle. Smaller and dimmer than the tab name, so
+ * the row still reads as one label with detail under it rather than two
+ * competing lines.
+ */
+.ghostty-tab-sidebar .ghostty-tab-branch,
+.ghostty-tab-sidebar .ghostty-tab-subtitle {
+  font-size: 0.8em;
+  opacity: 0.55;
+}
+
+/*
+ * A tab whose bell rang. The indicator icon says so when the sidebar is
+ * expanded, but on the rail there is no room for one, so the tab's own icon
+ * takes the accent colour instead -- the rail is precisely where an
+ * unattended tab needs to be able to shout.
+ *
+ * Literal first, then the variable, for the same cross-provider reason as the
+ * colors at the top of this section.
+ */
+.ghostty-tab-sidebar .ghostty-tab-attention .ghostty-tab-icon {
+  color: #3584e4;
+  color: var(--accent-color);
+}
+
+/*
+ * Scrim covering the terminal while the sidebar is expanded, from the
+ * sidebar's inner edge to the far side of the window. It is a sibling overlay
+ * drawn *under* the sidebar, so the sidebar's own area stays undimmed.
+ *
+ * can-target=false in the blueprint keeps it from swallowing clicks meant for
+ * the terminal underneath.
+ */
+.ghostty-tab-sidebar-dim {
+  background-color: transparent;
+  transition: background-color 180ms ease;
+}
+
+.ghostty-tab-sidebar-dim.active {
+  background-color: rgba(0, 0, 0, 0.35);
+}
diff --git a/src/apprt/gtk/tab_sidebar_git.zig b/src/apprt/gtk/tab_sidebar_git.zig
new file mode 100644
index 0000000..233e2d5
--- /dev/null
+++ b/src/apprt/gtk/tab_sidebar_git.zig
@@ -0,0 +1,230 @@
+//! Just enough git to put a branch name on a tab.
+//!
+//! This deliberately does not link libgit2 or shell out. A tab only needs the
+//! name of the branch its working directory is on, and that is one file:
+//! `HEAD`, whose entire contents are either `ref: refs/heads/<name>` or a raw
+//! object id. Reading it directly costs one `open` per change, keeps the
+//! dependency list of the patch at zero, and -- because it *is* a file -- lets
+//! a `GFileMonitor` tell us when to read it again instead of polling.
+//!
+//! What that gives up: anything requiring the index or the object database.
+//! There is no dirty marker and no ahead/behind count here, and adding either
+//! would mean a real git library.
+
+const std = @import("std");
+
+const log = std.log.scoped(.gtk_ghostty_tab_sidebar);
+
+/// Longest branch name we will show. Beyond this it is truncated with an
+/// ellipsis; a row is not the place to read a 200-character branch name.
+pub const max_branch_len: usize = 48;
+
+/// Walk up from `dir` looking for a repository, and return the path of the
+/// `HEAD` file that governs it. Caller owns the result.
+///
+/// Stops at the filesystem root. A worktree or submodule has `.git` as a
+/// *file* containing `gitdir: <path>`, which is followed once -- that is where
+/// its own HEAD lives, so a worktree correctly reports its own branch rather
+/// than the main checkout's.
+pub fn headPath(alloc: std.mem.Allocator, dir: []const u8) ?[:0]u8 {
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    var cur = dir;
+
+    while (true) {
+        const dot_git = std.fmt.bufPrint(&buf, "{s}/.git", .{cur}) catch return null;
+
+        if (std.fs.cwd().statFile(dot_git)) |stat| switch (stat.kind) {
+            .directory => return std.fmt.allocPrintSentinel(
+                alloc,
+                "{s}/HEAD",
+                .{dot_git},
+                0,
+            ) catch null,
+
+            .file => return headFromGitdirFile(alloc, cur, dot_git),
+
+            else => {},
+        } else |_| {}
+
+        const parent = std.fs.path.dirname(cur) orelse return null;
+        if (parent.len == cur.len) return null;
+        cur = parent;
+    }
+}
+
+/// `.git` is a file: read the `gitdir:` line out of it and point at the HEAD
+/// inside. The path may be relative, in which case it is relative to the
+/// directory holding the `.git` file.
+fn headFromGitdirFile(
+    alloc: std.mem.Allocator,
+    parent_dir: []const u8,
+    dot_git: []const u8,
+) ?[:0]u8 {
+    const contents = std.fs.cwd().readFileAlloc(alloc, dot_git, 4096) catch return null;
+    defer alloc.free(contents);
+
+    const prefix = "gitdir:";
+    if (!std.mem.startsWith(u8, contents, prefix)) return null;
+
+    const raw = std.mem.trim(u8, contents[prefix.len..], " \t\r\n");
+    if (raw.len == 0) return null;
+
+    return if (std.fs.path.isAbsolute(raw))
+        std.fmt.allocPrintSentinel(alloc, "{s}/HEAD", .{raw}, 0) catch null
+    else
+        std.fmt.allocPrintSentinel(alloc, "{s}/{s}/HEAD", .{ parent_dir, raw }, 0) catch null;
+}
+
+/// Read a branch name out of a `HEAD` file. Caller owns the result.
+///
+/// A detached HEAD holds an object id rather than a ref; it is shown as a
+/// short id, the way git itself describes that state.
+pub fn readBranch(alloc: std.mem.Allocator, head_path: []const u8) ?[]u8 {
+    const contents = std.fs.cwd().readFileAlloc(alloc, head_path, 4096) catch |err| {
+        // A repository being rebased or cloned can have HEAD momentarily
+        // absent. That is not worth a warning on every file-monitor event.
+        if (err != error.FileNotFound) {
+            log.debug("unable to read {s}: {}", .{ head_path, err });
+        }
+        return null;
+    };
+    defer alloc.free(contents);
+
+    const line = std.mem.trim(u8, contents, " \t\r\n");
+    if (line.len == 0) return null;
+
+    const name = if (std.mem.startsWith(u8, line, "ref:")) name: {
+        const ref = std.mem.trim(u8, line[4..], " \t");
+        // Show the last component: `refs/heads/foo/bar` is the branch
+        // `foo/bar`, so only the two known prefixes are stripped.
+        break :name stripPrefix(stripPrefix(ref, "refs/heads/"), "refs/");
+    } else line[0..@min(line.len, 7)];
+
+    if (name.len == 0) return null;
+
+    if (name.len > max_branch_len) {
+        return std.fmt.allocPrint(
+            alloc,
+            "{s}…",
+            .{name[0..max_branch_len]},
+        ) catch null;
+    }
+    return alloc.dupe(u8, name) catch null;
+}
+
+fn stripPrefix(s: []const u8, prefix: []const u8) []const u8 {
+    return if (std.mem.startsWith(u8, s, prefix)) s[prefix.len..] else s;
+}
+
+test "branch name from a symbolic HEAD" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    try tmp.dir.writeFile(.{ .sub_path = "HEAD", .data = "ref: refs/heads/main\n" });
+
+    const path = try tmp.dir.realpathAlloc(alloc, "HEAD");
+    defer alloc.free(path);
+
+    const branch = readBranch(alloc, path).?;
+    defer alloc.free(branch);
+    try testing.expectEqualStrings("main", branch);
+}
+
+test "slashes inside a branch name survive" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    try tmp.dir.writeFile(.{
+        .sub_path = "HEAD",
+        .data = "ref: refs/heads/feature/sidebar\n",
+    });
+
+    const path = try tmp.dir.realpathAlloc(alloc, "HEAD");
+    defer alloc.free(path);
+
+    const branch = readBranch(alloc, path).?;
+    defer alloc.free(branch);
+    try testing.expectEqualStrings("feature/sidebar", branch);
+}
+
+test "detached HEAD shows a short object id" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    try tmp.dir.writeFile(.{
+        .sub_path = "HEAD",
+        .data = "9fceb02d0ae598e95dc970b74767f19372d61af8\n",
+    });
+
+    const path = try tmp.dir.realpathAlloc(alloc, "HEAD");
+    defer alloc.free(path);
+
+    const branch = readBranch(alloc, path).?;
+    defer alloc.free(branch);
+    try testing.expectEqualStrings("9fceb02", branch);
+}
+
+test "a worktree's .git file is followed to its own HEAD" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+
+    const root = try tmp.dir.realpathAlloc(alloc, ".");
+    defer alloc.free(root);
+
+    // The real repository, with the worktree's HEAD inside it.
+    try tmp.dir.makePath("main/.git/worktrees/wt");
+    try tmp.dir.writeFile(.{
+        .sub_path = "main/.git/worktrees/wt/HEAD",
+        .data = "ref: refs/heads/side\n",
+    });
+
+    // The worktree itself: `.git` is a file pointing back at that directory.
+    try tmp.dir.makePath("wt/deep/deeper");
+    const gitdir = try std.fmt.allocPrint(
+        alloc,
+        "gitdir: {s}/main/.git/worktrees/wt\n",
+        .{root},
+    );
+    defer alloc.free(gitdir);
+    try tmp.dir.writeFile(.{ .sub_path = "wt/.git", .data = gitdir });
+
+    // Found from a subdirectory, and it is the worktree's branch, not the
+    // main checkout's.
+    const from = try std.fmt.allocPrint(alloc, "{s}/wt/deep/deeper", .{root});
+    defer alloc.free(from);
+
+    const head = headPath(alloc, from).?;
+    defer alloc.free(head);
+
+    const branch = readBranch(alloc, head).?;
+    defer alloc.free(branch);
+    try testing.expectEqualStrings("side", branch);
+}
+
+test "a directory outside any repository has no HEAD" {
+    const testing = std.testing;
+    try testing.expectEqual(
+        @as(?[:0]u8, null),
+        headPath(testing.allocator, "/proc/self"),
+    );
+}
+
+test "a missing HEAD is not an error" {
+    const testing = std.testing;
+    try testing.expectEqual(
+        @as(?[]u8, null),
+        readBranch(testing.allocator, "/nonexistent/HEAD"),
+    );
+}
diff --git a/src/apprt/gtk/tab_sidebar_prefs.zig b/src/apprt/gtk/tab_sidebar_prefs.zig
new file mode 100644
index 0000000..a4b8c97
--- /dev/null
+++ b/src/apprt/gtk/tab_sidebar_prefs.zig
@@ -0,0 +1,412 @@
+//! The sidebar's preferences dialog.
+//!
+//! Built in code rather than as a blueprint. Every row here is mechanically
+//! derived from one field of `Settings`, and a blueprint would mean naming all
+//! thirteen of them twice -- once in the `.blp` and once when reading them
+//! back -- with nothing checking the two lists still agree.
+//!
+//! One handler serves every row. Rather than each widget knowing which field
+//! it owns, any change re-reads the whole dialog and rebuilds a `Settings`
+//! from it. That keeps the widget-to-field mapping in exactly one place, and
+//! means normalization runs against the complete picture: raising the icon
+//! size past the rail width has to be able to see the width.
+
+const std = @import("std");
+
+const adw = @import("adw");
+const gio = @import("gio");
+const gobject = @import("gobject");
+const gtk = @import("gtk");
+
+const Settings = @import("tab_sidebar_settings.zig");
+
+const log = std.log.scoped(.gtk_ghostty_tab_sidebar);
+
+/// Called whenever the dialog changes something, with the new settings
+/// already normalized. The sidebar applies them; this module also writes them
+/// to `sidebar.conf` so they outlive the window.
+pub const Apply = *const fn (ctx: ?*anyopaque, settings: Settings) void;
+
+const State = struct {
+    alloc: std.mem.Allocator,
+    apply: Apply,
+    ctx: ?*anyopaque,
+
+    /// Where the reset button goes back to: the config with no `sidebar.conf`
+    /// layered on it.
+    defaults: Settings,
+
+    /// Set while the dialog is writing its own widgets, so the change
+    /// handler does not treat normalization's corrections as user edits and
+    /// recurse.
+    updating: bool = false,
+
+    width: *adw.SpinRow,
+    expanded_width: *adw.SpinRow,
+    corner_radius: *adw.SpinRow,
+    icon_size: *adw.SpinRow,
+    animation_duration: *adw.SpinRow,
+    collapse_delay: *adw.SpinRow,
+
+    border: *adw.SwitchRow,
+    auto_hide: *adw.SwitchRow,
+    new_button: *adw.SwitchRow,
+    git_branch: *adw.SwitchRow,
+    indicators: *adw.SwitchRow,
+    theme_icons: *adw.SwitchRow,
+
+    mode: *adw.ComboRow,
+    subtitle: *adw.ComboRow,
+
+    fn read(self: *const State) Settings {
+        var s: Settings = .{
+            .width = spin(u16, self.width),
+            .expanded_width = spin(u16, self.expanded_width),
+            .corner_radius = spin(u8, self.corner_radius),
+            .icon_size = spin(u8, self.icon_size),
+            .animation_duration = spin(u16, self.animation_duration),
+            .collapse_delay = spin(u16, self.collapse_delay),
+            .border = self.border.getActive() != 0,
+            .auto_hide = self.auto_hide.getActive() != 0,
+            .new_button = self.new_button.getActive() != 0,
+            .git_branch = self.git_branch.getActive() != 0,
+            .indicators = self.indicators.getActive() != 0,
+            .theme_icons = self.theme_icons.getActive() != 0,
+            .mode = enumAt(Settings.Mode, self.mode),
+            .subtitle = enumAt(Settings.Subtitle, self.subtitle),
+        };
+        s.normalize();
+        return s;
+    }
+
+    fn write(self: *State, s: Settings) void {
+        self.updating = true;
+        defer self.updating = false;
+
+        setSpin(self.width, s.width);
+        setSpin(self.expanded_width, s.expanded_width);
+        setSpin(self.corner_radius, s.corner_radius);
+        setSpin(self.icon_size, s.icon_size);
+        setSpin(self.animation_duration, s.animation_duration);
+        setSpin(self.collapse_delay, s.collapse_delay);
+
+        self.border.setActive(@intFromBool(s.border));
+        self.auto_hide.setActive(@intFromBool(s.auto_hide));
+        self.new_button.setActive(@intFromBool(s.new_button));
+        self.git_branch.setActive(@intFromBool(s.git_branch));
+        self.indicators.setActive(@intFromBool(s.indicators));
+        self.theme_icons.setActive(@intFromBool(s.theme_icons));
+
+        self.mode.setSelected(@intFromEnum(s.mode));
+        self.subtitle.setSelected(@intFromEnum(s.subtitle));
+    }
+};
+
+fn spin(comptime T: type, row: *adw.SpinRow) T {
+    return std.math.lossyCast(T, @round(row.getValue()));
+}
+
+fn setSpin(row: *adw.SpinRow, value: anytype) void {
+    row.setValue(@floatFromInt(value));
+}
+
+fn enumAt(comptime T: type, row: *adw.ComboRow) T {
+    const i = row.getSelected();
+    const fields = @typeInfo(T).@"enum".fields;
+    inline for (fields, 0..) |f, idx| {
+        if (i == idx) return @field(T, f.name);
+    }
+    return @enumFromInt(0);
+}
+
+/// Open the dialog over `parent`.
+pub fn present(
+    alloc: std.mem.Allocator,
+    parent: *gtk.Widget,
+    current: Settings,
+    defaults: Settings,
+    apply: Apply,
+    ctx: ?*anyopaque,
+) void {
+    const dialog = adw.PreferencesDialog.new();
+    dialog.as(adw.Dialog).setTitle("Tab Sidebar");
+
+    const page = adw.PreferencesPage.new();
+    page.setTitle("Sidebar");
+    page.setIconName("view-sidebar-start-symbolic");
+
+    const state = alloc.create(State) catch {
+        log.warn("unable to allocate sidebar preferences state", .{});
+        return;
+    };
+
+    // --- Size -----------------------------------------------------------
+    const size = group("Size", "Widths are in pixels. The rail width is what " ++
+        "the terminal makes room for; the expanded width is only how far the " ++
+        "panel opens.");
+    const width = spinRow("Rail width", null, 16, 200);
+    const expanded_width = spinRow("Expanded width", null, 16, 800);
+    const icon_size = spinRow(
+        "Icon size",
+        "The square each tab icon is drawn in. Shrinks to fit the rail.",
+        8,
+        128,
+    );
+    const corner_radius = spinRow(
+        "Corner radius",
+        "Rounding on the edge facing the terminal.",
+        0,
+        64,
+    );
+    size.add(width.as(gtk.Widget));
+    size.add(expanded_width.as(gtk.Widget));
+    size.add(icon_size.as(gtk.Widget));
+    size.add(corner_radius.as(gtk.Widget));
+    page.add(size);
+
+    // --- Behaviour ------------------------------------------------------
+    const behaviour = group(
+        "Behaviour",
+        "Hover rests as a rail and opens over the terminal. Always expanded " ++
+            "stays open and reserves its width. Always a rail never opens, " ++
+            "and puts tab names in tooltips instead.",
+    );
+    // No subtitle. An AdwComboRow gives its selected value whatever width
+    // the title and subtitle leave over, and three lines of explanation left
+    // "Always expanded" rendered as "A…".
+    const mode = comboRow(
+        "Mode",
+        null,
+        &.{ "Expand on hover", "Always expanded", "Always a rail" },
+    );
+    const auto_hide = switchRow(
+        "Hide with one tab",
+        "Give the space back to the terminal until a second tab exists.",
+    );
+    const new_button = switchRow("Show the New Tab button", null);
+    behaviour.add(mode.as(gtk.Widget));
+    behaviour.add(auto_hide.as(gtk.Widget));
+    behaviour.add(new_button.as(gtk.Widget));
+    page.add(behaviour);
+
+    // --- Tabs -----------------------------------------------------------
+    const tabs = group("Tabs", null);
+    const subtitle = comboRow(
+        "Second line",
+        null,
+        &.{ "Nothing", "Terminal title", "Working directory" },
+    );
+    const git_branch = switchRow(
+        "Show the git branch",
+        "Costs one file watch per tab on its repository's HEAD.",
+    );
+    const indicators = switchRow(
+        "Show status icons",
+        "A bell when a tab rings one, and a padlock when it is read-only.",
+    );
+    tabs.add(subtitle.as(gtk.Widget));
+    tabs.add(git_branch.as(gtk.Widget));
+    tabs.add(indicators.as(gtk.Widget));
+
+    const theme_icons = switchRow(
+        "Use the desktop icon theme",
+        "Off by default: the sidebar draws from Adwaita so its icons read as " ++
+            "one set whatever theme you use.",
+    );
+    tabs.add(theme_icons.as(gtk.Widget));
+    page.add(tabs);
+
+    // --- Timing ---------------------------------------------------------
+    const timing = group("Timing", "In milliseconds.");
+    const animation_duration = spinRow(
+        "Slide duration",
+        "Zero switches between the two widths instantly.",
+        0,
+        2000,
+    );
+    const collapse_delay = spinRow(
+        "Collapse delay",
+        "How long the sidebar waits after the pointer leaves it.",
+        0,
+        5000,
+    );
+    const border = switchRow("Edge line", "A hairline against the terminal.");
+    timing.add(animation_duration.as(gtk.Widget));
+    timing.add(collapse_delay.as(gtk.Widget));
+    timing.add(border.as(gtk.Widget));
+    page.add(timing);
+
+    // --- Reset -----------------------------------------------------------
+    const reset_group = group(
+        "Reset",
+        "Puts every setting above back to its default and deletes the " ++
+            "sidebar's own settings file, so it follows your Ghostty config " ++
+            "again.",
+    );
+    const reset = gtk.Button.newWithLabel("Reset to defaults");
+    reset.as(gtk.Widget).addCssClass("destructive-action");
+    reset.as(gtk.Widget).setHalign(.start);
+    reset.as(gtk.Widget).setMarginTop(6);
+    reset_group.add(reset.as(gtk.Widget));
+    page.add(reset_group);
+
+    state.* = .{
+        .alloc = alloc,
+        .apply = apply,
+        .ctx = ctx,
+        .defaults = defaults,
+        .width = width,
+        .expanded_width = expanded_width,
+        .corner_radius = corner_radius,
+        .icon_size = icon_size,
+        .animation_duration = animation_duration,
+        .collapse_delay = collapse_delay,
+        .border = border,
+        .auto_hide = auto_hide,
+        .new_button = new_button,
+        .git_branch = git_branch,
+        .indicators = indicators,
+        .theme_icons = theme_icons,
+        .mode = mode,
+        .subtitle = subtitle,
+    };
+
+    // Fill the widgets before connecting, so seeding them is not mistaken
+    // for thirteen separate edits.
+    state.write(current);
+
+    // Three handlers rather than one, because the connect helper types the
+    // callback against the emitting widget. They all do the same thing.
+    inline for (.{ "width", "expanded_width", "corner_radius", "icon_size", "animation_duration", "collapse_delay" }) |name| {
+        _ = gobject.Object.signals.notify.connect(
+            @field(state, name),
+            *State,
+            &spinChanged,
+            state,
+            .{ .detail = "value" },
+        );
+    }
+    inline for (.{ "border", "auto_hide", "new_button", "git_branch", "indicators", "theme_icons" }) |name| {
+        _ = gobject.Object.signals.notify.connect(
+            @field(state, name),
+            *State,
+            &switchChanged,
+            state,
+            .{ .detail = "active" },
+        );
+    }
+    inline for (.{ "mode", "subtitle" }) |name| {
+        _ = gobject.Object.signals.notify.connect(
+            @field(state, name),
+            *State,
+            &comboChanged,
+            state,
+            .{ .detail = "selected" },
+        );
+    }
+
+    _ = gtk.Button.signals.clicked.connect(reset, *State, &resetClicked, state, .{});
+
+    dialog.add(page);
+
+    _ = adw.Dialog.signals.closed.connect(
+        dialog.as(adw.Dialog),
+        *State,
+        &closed,
+        state,
+        .{},
+    );
+
+    dialog.as(adw.Dialog).present(parent);
+}
+
+fn spinChanged(_: *adw.SpinRow, _: *gobject.ParamSpec, state: *State) callconv(.c) void {
+    changed(state);
+}
+
+fn switchChanged(_: *adw.SwitchRow, _: *gobject.ParamSpec, state: *State) callconv(.c) void {
+    changed(state);
+}
+
+fn comboChanged(_: *adw.ComboRow, _: *gobject.ParamSpec, state: *State) callconv(.c) void {
+    changed(state);
+}
+
+fn changed(state: *State) void {
+    if (state.updating) return;
+
+    const s = state.read();
+    state.apply(state.ctx, s);
+
+    // Normalization may have moved a value the user just typed -- an icon
+    // bigger than the rail, an odd difference. Show them what actually took
+    // effect rather than leaving the widget disagreeing with the sidebar.
+    state.write(s);
+
+    s.save(state.alloc) catch |err| {
+        log.warn("unable to save sidebar settings: {}", .{err});
+    };
+}
+
+fn resetClicked(_: *gtk.Button, state: *State) callconv(.c) void {
+    // Fill the widgets first, with `updating` held, so thirteen notify
+    // signals do not each rewrite the file we are about to delete.
+    state.write(state.defaults);
+    state.apply(state.ctx, state.defaults);
+
+    Settings.deleteFile(state.alloc) catch |err| {
+        // The settings still took effect; only the file outlived them. Say so
+        // rather than pretend, because the old values would come back on the
+        // next config reload.
+        log.warn("unable to remove the sidebar settings file: {}", .{err});
+    };
+}
+
+fn closed(_: *adw.Dialog, state: *State) callconv(.c) void {
+    state.alloc.destroy(state);
+}
+
+//---------------------------------------------------------------
+// Row builders
+
+fn group(title: [*:0]const u8, description: ?[*:0]const u8) *adw.PreferencesGroup {
+    const g = adw.PreferencesGroup.new();
+    g.setTitle(title);
+    if (description) |d| g.setDescription(d);
+    return g;
+}
+
+fn spinRow(
+    title: [*:0]const u8,
+    subtitle: ?[*:0]const u8,
+    min: f64,
+    max: f64,
+) *adw.SpinRow {
+    const adjustment = gtk.Adjustment.new(min, min, max, 1, 10, 0);
+    const row = adw.SpinRow.new(adjustment, 1, 0);
+    row.as(adw.PreferencesRow).setTitle(title);
+    if (subtitle) |s| row.as(adw.ActionRow).setSubtitle(s);
+    return row;
+}
+
+fn switchRow(title: [*:0]const u8, subtitle: ?[*:0]const u8) *adw.SwitchRow {
+    const row = adw.SwitchRow.new();
+    row.as(adw.PreferencesRow).setTitle(title);
+    if (subtitle) |s| row.as(adw.ActionRow).setSubtitle(s);
+    return row;
+}
+
+fn comboRow(
+    title: [*:0]const u8,
+    subtitle: ?[*:0]const u8,
+    labels: []const [*:0]const u8,
+) *adw.ComboRow {
+    const row = adw.ComboRow.new();
+    row.as(adw.PreferencesRow).setTitle(title);
+    if (subtitle) |s| row.as(adw.ActionRow).setSubtitle(s);
+
+    const list = gtk.StringList.new(null);
+    for (labels) |l| list.append(l);
+    row.setModel(list.as(gio.ListModel));
+    return row;
+}
diff --git a/src/apprt/gtk/tab_sidebar_settings.zig b/src/apprt/gtk/tab_sidebar_settings.zig
new file mode 100644
index 0000000..dc103e9
--- /dev/null
+++ b/src/apprt/gtk/tab_sidebar_settings.zig
@@ -0,0 +1,406 @@
+//! Live settings for the vertical tab sidebar.
+//!
+//! Every value here also exists as a `gtk-tabs-sidebar-*` config option. The
+//! config is the baseline; this module layers a small file of its own on top
+//! so the sidebar's own menu can change things without editing the user's
+//! hand-written config.
+//!
+//! That split is deliberate. Ghostty never writes its config file -- the only
+//! thing it does with it is open it in an editor -- and a patch that started
+//! rewriting a file the user maintains by hand would have to preserve their
+//! comments, ordering and formatting to be safe. Instead the sidebar owns
+//! `$XDG_CONFIG_HOME/ghostty/sidebar.conf`, writes only keys it recognises,
+//! and rewrites it wholesale because everything in it is ours.
+//!
+//! Precedence, lowest to highest: field default, `gtk-tabs-sidebar-*` from
+//! the config, then `sidebar.conf`. So a value the user has never touched in
+//! the menu keeps following their config.
+
+const std = @import("std");
+
+const glib = @import("glib");
+
+const Config = @import("../../config.zig").Config;
+
+const log = std.log.scoped(.gtk_ghostty_tab_sidebar);
+
+pub const Mode = Config.GtkTabsSidebarMode;
+pub const Subtitle = Config.GtkTabsSidebarSubtitle;
+
+pub const Settings = @This();
+
+/// Geometry.
+width: u16 = 54,
+expanded_width: u16 = 260,
+corner_radius: u8 = 12,
+icon_size: u8 = 32,
+border: bool = true,
+
+/// Timing, in milliseconds.
+animation_duration: u16 = 320,
+collapse_delay: u16 = 400,
+
+/// Behaviour.
+auto_hide: bool = true,
+mode: Mode = .hover,
+new_button: bool = true,
+
+/// Row content.
+git_branch: bool = true,
+subtitle: Subtitle = .title,
+indicators: bool = true,
+
+/// Draw icons from Adwaita rather than the desktop theme; see
+/// `gtk-tabs-sidebar-theme-icons`.
+theme_icons: bool = false,
+
+/// The file we own, relative to the user's config directory.
+const file_name = "sidebar.conf";
+
+/// Every field, paired with the name used in `sidebar.conf`. Keeping this in
+/// one place is what lets load, save and the preferences dialog stay in step:
+/// adding a setting means adding one line here and one field above.
+pub const keys = .{
+    .{ "width", "width" },
+    .{ "expanded-width", "expanded_width" },
+    .{ "corner-radius", "corner_radius" },
+    .{ "icon-size", "icon_size" },
+    .{ "border", "border" },
+    .{ "animation-duration", "animation_duration" },
+    .{ "collapse-delay", "collapse_delay" },
+    .{ "auto-hide", "auto_hide" },
+    .{ "mode", "mode" },
+    .{ "new-button", "new_button" },
+    .{ "git-branch", "git_branch" },
+    .{ "subtitle", "subtitle" },
+    .{ "indicators", "indicators" },
+    .{ "theme-icons", "theme_icons" },
+};
+
+/// Start from the config. This is the baseline the file is layered onto.
+pub fn fromConfig(config: *const Config) Settings {
+    return .{
+        .width = config.@"gtk-tabs-sidebar-width",
+        .expanded_width = config.@"gtk-tabs-sidebar-expanded-width",
+        .corner_radius = config.@"gtk-tabs-sidebar-corner-radius",
+        .icon_size = config.@"gtk-tabs-sidebar-icon-size",
+        .border = config.@"gtk-tabs-sidebar-border",
+        .animation_duration = config.@"gtk-tabs-sidebar-animation-duration",
+        .collapse_delay = config.@"gtk-tabs-sidebar-collapse-delay",
+        .auto_hide = config.@"gtk-tabs-sidebar-auto-hide",
+        .mode = config.@"gtk-tabs-sidebar-mode",
+        .new_button = config.@"gtk-tabs-sidebar-new-button",
+        .git_branch = config.@"gtk-tabs-sidebar-git-branch",
+        .subtitle = config.@"gtk-tabs-sidebar-subtitle",
+        .indicators = config.@"gtk-tabs-sidebar-indicators",
+        .theme_icons = config.@"gtk-tabs-sidebar-theme-icons",
+    };
+}
+
+/// Config values with `sidebar.conf` layered on top. A missing or unreadable
+/// file is not an error: it just means nothing has overridden the config yet.
+pub fn load(alloc: std.mem.Allocator, config: *const Config) Settings {
+    var self = fromConfig(config);
+
+    const path = configPath(alloc) catch return self;
+    defer alloc.free(path);
+
+    const contents = std.fs.cwd().readFileAlloc(alloc, path, 64 * 1024) catch |err| switch (err) {
+        error.FileNotFound => return self,
+        else => {
+            log.warn("unable to read {s}: {}", .{ path, err });
+            return self;
+        },
+    };
+    defer alloc.free(contents);
+
+    self.parse(contents);
+    self.normalize();
+    return self;
+}
+
+/// Force the geometry into a shape the sidebar can actually draw.
+///
+/// These used to be a `comptime` assertion, which a configurable width cannot
+/// be: a bad value now arrives at runtime from a config file. Refusing to
+/// start over it would be worse than nudging it, so each rule adjusts the
+/// value and says so once.
+///
+/// The evenness rule is the load-bearing one. The icon chip is centred by
+/// equal CSS margins of `(width - icon_size) / 2`, so an odd difference
+/// cannot be split evenly and every icon sits half a pixel off the rail's
+/// centre line -- visible as a column that drifts against the "+" button.
+pub fn normalize(self: *Settings) void {
+    // An expanded panel narrower than the rail would animate backwards.
+    if (self.expanded_width < self.width) {
+        log.warn(
+            "sidebar expanded-width {d} is under width {d}; using {d}",
+            .{ self.expanded_width, self.width, self.width },
+        );
+        self.expanded_width = self.width;
+    }
+
+    // The chip has to fit inside the rail with room to centre it.
+    const width_u8 = std.math.cast(u8, self.width) orelse std.math.maxInt(u8);
+    if (self.icon_size > width_u8) {
+        log.warn(
+            "sidebar icon-size {d} exceeds width {d}; using {d}",
+            .{ self.icon_size, self.width, width_u8 },
+        );
+        self.icon_size = width_u8;
+    }
+
+    // The "New Tab" button carries `button_padding` of Adwaita padding that
+    // our `padding: 0` never wins against, so it is aligned by giving it that
+    // much *less* margin than the rows. Which only works while the rows have
+    // that much margin to give: below it the subtraction saturates at zero and
+    // the "+" sits several pixels inside the tab icons, on its own axis.
+    //
+    // Rather than let the pair silently come apart, keep enough room for it.
+    const min_margin = 2 * button_padding;
+    if (self.width -| @as(u16, self.icon_size) < min_margin) {
+        const fits = std.math.cast(u8, self.width -| min_margin) orelse 0;
+        log.warn(
+            "sidebar icon-size {d} leaves no room to align the New Tab button " ++
+                "in a {d}px rail; using {d}",
+            .{ self.icon_size, self.width, fits },
+        );
+        self.icon_size = fits;
+    }
+
+    if ((self.width -| @as(u16, self.icon_size)) % 2 != 0) {
+        self.icon_size -|= 1;
+        log.warn(
+            "sidebar width {d} and icon-size cannot be centred; icon-size is now {d}",
+            .{ self.width, self.icon_size },
+        );
+    }
+}
+
+/// Margins that centre an icon chip in the rail, in pixels.
+///
+/// The pair is derived, never written down twice. A row's icon gets the plain
+/// half-difference; the "New Tab" button gets that less `button_padding`,
+/// because a flat GTK button carries Adwaita padding of its own that our
+/// `padding: 0` does not win against. Hardcoding either one drifts the moment
+/// the width changes.
+pub const button_padding: u16 = 6;
+
+/// Natural size of a symbolic icon. Themes draw them at this by default, and
+/// the sidebar was designed around a glyph this size sitting in a larger chip.
+pub const natural_glyph: u8 = 16;
+
+/// How big to draw the glyph itself, as opposed to the chip around it.
+///
+/// `icon_size` is the *chip* -- the square an icon sits in, and the size of
+/// the rounded highlight behind a selected tab. It was `icon_chip` before it
+/// became configurable, set with `set_size_request`, which raises only a
+/// minimum: the glyph kept its natural 16px and the chip was the 32px box
+/// around it. That gap is the design.
+///
+/// Forcing the glyph to the chip size instead -- which is what `set_pixel_size`
+/// on `icon_size` did -- doubled every icon at the same setting and filled the
+/// chip edge to edge. So the glyph gets its natural size, shrunk only when the
+/// chip is too small to hold it.
+pub fn glyphSize(self: *const Settings) u8 {
+    return @min(self.icon_size, natural_glyph);
+}
+
+pub fn iconMargin(self: *const Settings) u16 {
+    return (self.width -| @as(u16, self.icon_size)) / 2;
+}
+
+pub fn newButtonMargin(self: *const Settings) u16 {
+    return self.iconMargin();
+}
+
+/// Apply `key = value` lines. Unknown keys and unparseable values are skipped
+/// with a warning rather than discarding the whole file: a setting we no
+/// longer recognise should not cost the user every other setting.
+fn parse(self: *Settings, contents: []const u8) void {
+    var lines = std.mem.splitScalar(u8, contents, '\n');
+    while (lines.next()) |raw| {
+        const line = std.mem.trim(u8, raw, " \t\r");
+        if (line.len == 0 or line[0] == '#') continue;
+
+        const eq = std.mem.indexOfScalar(u8, line, '=') orelse continue;
+        const key = std.mem.trim(u8, line[0..eq], " \t");
+        const value = std.mem.trim(u8, line[eq + 1 ..], " \t");
+
+        if (!self.set(key, value)) {
+            log.warn("ignoring unrecognised sidebar setting: {s}", .{key});
+        }
+    }
+}
+
+/// Assign one key from its textual value. Returns false if the key is unknown
+/// or the value does not parse.
+pub fn set(self: *Settings, key: []const u8, value: []const u8) bool {
+    inline for (keys) |pair| {
+        const name, const field = pair;
+        if (std.mem.eql(u8, key, name)) {
+            const T = @TypeOf(@field(self, field));
+            @field(self, field) = switch (@typeInfo(T)) {
+                .bool => parseBool(value) orelse return false,
+                .int => std.fmt.parseInt(T, value, 10) catch return false,
+                .@"enum" => std.meta.stringToEnum(T, value) orelse return false,
+                else => @compileError("unhandled sidebar setting type"),
+            };
+            return true;
+        }
+    }
+    return false;
+}
+
+fn parseBool(value: []const u8) ?bool {
+    if (std.mem.eql(u8, value, "true")) return true;
+    if (std.mem.eql(u8, value, "false")) return false;
+    return null;
+}
+
+/// Write every setting back out. The file is ours alone, so it is rewritten
+/// whole rather than patched line by line.
+pub fn save(self: *const Settings, alloc: std.mem.Allocator) !void {
+    const path = try configPath(alloc);
+    defer alloc.free(path);
+
+    if (std.fs.path.dirname(path)) |dir| {
+        std.fs.cwd().makePath(dir) catch |err| switch (err) {
+            error.PathAlreadyExists => {},
+            else => return err,
+        };
+    }
+
+    var buf: std.ArrayListUnmanaged(u8) = .empty;
+    defer buf.deinit(alloc);
+    const w = buf.writer(alloc);
+
+    try w.writeAll(
+        \\# Written by Ghostty's vertical tab sidebar.
+        \\#
+        \\# Values you change by hand are read back, but the whole file is
+        \\# rewritten whenever a setting changes in Sidebar Preferences, so
+        \\# comments and ordering of your own will not survive that.
+        \\#
+        \\# These override the matching gtk-tabs-sidebar-* options in your
+        \\# Ghostty config. Delete a line to go back to following the config.
+        \\
+        \\
+    );
+
+    inline for (keys) |pair| {
+        const name, const field = pair;
+        const value = @field(self, field);
+        switch (@typeInfo(@TypeOf(value))) {
+            .bool => try w.print("{s} = {s}\n", .{ name, if (value) "true" else "false" }),
+            .int => try w.print("{s} = {d}\n", .{ name, value }),
+            .@"enum" => try w.print("{s} = {s}\n", .{ name, @tagName(value) }),
+            else => unreachable,
+        }
+    }
+
+    // Write to a temporary file and rename over the target, so an interrupted
+    // write cannot leave a half-written settings file behind.
+    const tmp = try std.fmt.allocPrint(alloc, "{s}.tmp", .{path});
+    defer alloc.free(tmp);
+
+    try std.fs.cwd().writeFile(.{ .sub_path = tmp, .data = buf.items });
+    try std.fs.cwd().rename(tmp, path);
+}
+
+/// Throw away every override by deleting the file.
+///
+/// Deliberately not "write the defaults back": that would pin today's defaults
+/// into the file, so a `gtk-tabs-sidebar-*` line in the user's config would
+/// stay overridden by a value they had just asked to forget. Removing the file
+/// is what actually returns the sidebar to following the config.
+pub fn deleteFile(alloc: std.mem.Allocator) !void {
+    const path = try configPath(alloc);
+    defer alloc.free(path);
+
+    std.fs.cwd().deleteFile(path) catch |err| switch (err) {
+        error.FileNotFound => {},
+        else => return err,
+    };
+}
+
+fn configPath(alloc: std.mem.Allocator) ![]u8 {
+    const dir = glib.getUserConfigDir();
+    return std.fs.path.join(alloc, &.{ std.mem.span(dir), "ghostty", file_name });
+}
+
+test "parse overrides config values" {
+    const testing = std.testing;
+
+    var s: Settings = .{};
+    s.parse(
+        \\# a comment
+        \\width = 70
+        \\border = false
+        \\subtitle = path
+        \\nonsense = 12
+        \\
+    );
+
+    try testing.expectEqual(@as(u16, 70), s.width);
+    try testing.expectEqual(false, s.border);
+    try testing.expectEqual(Subtitle.path, s.subtitle);
+
+    // Untouched keys keep their prior value.
+    try testing.expectEqual(@as(u16, 260), s.expanded_width);
+}
+
+test "bad values leave the field alone" {
+    const testing = std.testing;
+
+    var s: Settings = .{};
+    try testing.expectEqual(false, s.set("width", "wide"));
+    try testing.expectEqual(@as(u16, 54), s.width);
+}
+
+test "normalize keeps the icon centreable" {
+    const testing = std.testing;
+
+    // An odd difference cannot be split into equal margins, so the chip
+    // shrinks by one until it can be.
+    var s: Settings = .{ .width = 54, .icon_size = 33 };
+    s.normalize();
+    try testing.expectEqual(@as(u8, 32), s.icon_size);
+    try testing.expectEqual(@as(u16, 11), s.iconMargin());
+
+    // A chip wider than the rail is clamped, with room left over so the
+    // margins stay positive.
+    var big: Settings = .{ .width = 20, .icon_size = 64 };
+    big.normalize();
+    try testing.expectEqual(@as(u8, 8), big.icon_size);
+    try testing.expectEqual(@as(u16, 6), big.iconMargin());
+
+    // Everything on the rail shares one margin, so everything shares one
+    // axis. This used to subtract `button_padding` from the "New Tab"
+    // button's, on the belief that a flat button carries Adwaita padding our
+    // `padding: 0` cannot beat. Measured against the pixels, it does not: the
+    // subtraction put the "+" six pixels left of the tab icons at every
+    // width, including the default.
+    for ([_]u16{ 16, 17, 33, 50, 54, 72, 200 }) |w| {
+        var each: Settings = .{ .width = w, .icon_size = 32 };
+        each.normalize();
+        try testing.expectEqual(each.iconMargin(), each.newButtonMargin());
+        try testing.expectEqual(
+            each.width,
+            each.iconMargin() * 2 + each.icon_size,
+        );
+    }
+}
+
+test "mode round-trips through the file format" {
+    const testing = std.testing;
+
+    var s: Settings = .{};
+    try testing.expectEqual(Mode.hover, s.mode);
+    s.parse("mode = rail\n");
+    try testing.expectEqual(Mode.rail, s.mode);
+
+    // The old boolean spelling is not silently accepted as a mode.
+    try testing.expectEqual(false, s.set("mode", "true"));
+    try testing.expectEqual(Mode.rail, s.mode);
+}
diff --git a/src/apprt/gtk/ui/1.5/tab-sidebar.blp b/src/apprt/gtk/ui/1.5/tab-sidebar.blp
new file mode 100644
index 0000000..9ca0988
--- /dev/null
+++ b/src/apprt/gtk/ui/1.5/tab-sidebar.blp
@@ -0,0 +1,234 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $GhosttyTabSidebar: Adw.Bin {
+  styles [
+    "ghostty-tab-sidebar",
+  ]
+
+  // This outer ScrolledWindow exists purely to sever natural-width
+  // propagation, not to scroll. GtkOverlay allocates an overlay child its
+  // *natural* width, and setSizeRequest only raises the minimum -- so the
+  // rail rendered at whatever its widest child needed and the width
+  // animation had no visible effect. Overriding the measure vfunc does not
+  // help either: Adw.Bin sizes through a layout manager, so the override is
+  // never called. A ScrolledWindow with propagate-natural-width disabled
+  // reports its min-content-width as its natural width, which puts the size
+  // request back in charge.
+  Gtk.ScrolledWindow clip {
+    hscrollbar-policy: external;
+    vscrollbar-policy: never;
+    propagate-natural-width: false;
+    min-content-width: 0;
+
+    Gtk.Box {
+      orientation: vertical;
+
+    // The top row: "New Tab" plus the two buttons Ghostty puts in its
+    // titlebar. Declared before the list and outside the ScrolledWindow, so
+    // the whole row stays pinned while the tabs scroll beneath it.
+    //
+    // Collapsed, only the "+" is shown and it occupies the whole rail. As the
+    // sidebar opens the other two fade in and the "+" gives up the width to
+    // make room, so the row grows into the space rather than rearranging.
+    Gtk.Box top_bar {
+      orientation: horizontal;
+      spacing: 0;
+
+      // Named so the runtime stylesheet can size the icons of the buttons in
+      // here. Their images are created by GTK from an icon-name rather than by
+      // us, so there is no widget to call set_pixel_size on -- and in rail
+      // mode the menu button is pinned on screen, where an unsized 16px glyph
+      // makes its button wider than the rail.
+      styles [
+        "ghostty-sidebar-top-bar",
+      ]
+
+      // Visibility is driven from Zig by `gtk-tabs-sidebar-new-button`.
+      Gtk.Button new_tab_button {
+        clicked => $new_tab_clicked();
+        can-focus: false;
+        focus-on-click: false;
+        hexpand: true;
+
+        styles [
+          "flat",
+        ]
+
+        // Deliberately a Box rather than Adw.ButtonContent: the label has to
+        // fade out entirely in rail mode, and ButtonContent gives no way to
+        // address its label on its own.
+        //
+        // No margin here -- the button's own margins in CSS centre it in the
+        // rail. The square is sized from Zig to match the tab rows', because
+        // symbolic icons differ in natural width, so aligning on the box
+        // rather than the glyph is what keeps the "+" in line with the tab
+        // icons below. The values here are only the default, for the moment
+        // between the template being built and the first settings push.
+        // No margin here. This used to carry a hand-measured margin-start of
+        // 4px to line the "+" up with the tab icons, which was only ever
+        // compensating for the listview insets that pushed the rows off
+        // centre. With those gone both the button and the rows are bare
+        // chips of the same size and the viewport centres them on the same
+        // axis.
+        // halign is switched from Zig: `start` expanded, so the icon leads the
+        // label, and `center` on the rail, so the icon centres in the button
+        // rather than sitting against whatever padding the GTK theme gives it.
+        // Leaving it at `start` let a third-party theme's button padding push
+        // the "+" several pixels off the axis of the tab icons below.
+        child: Gtk.Box new_tab_box {
+          orientation: horizontal;
+          spacing: 6;
+          halign: start;
+
+          Gtk.Image new_tab_icon {
+            icon-name: "tab-new-symbolic";
+            width-request: 32;
+            height-request: 32;
+          }
+
+          Gtk.Label new_tab_label {
+            label: _("New Tab");
+          }
+        };
+      }
+
+      // Both drive window actions rather than property bindings: the header
+      // bar can bind straight to tab_overview because it lives in the
+      // window's own template, but the sidebar is a separate class and
+      // cannot see it, so the overview toggle goes through
+      // win.toggle-tab-overview.
+      Gtk.Button overview_button {
+        action-name: "win.toggle-tab-overview";
+        icon-name: "view-grid-symbolic";
+        tooltip-text: _("View Open Tabs");
+        can-focus: false;
+        focus-on-click: false;
+
+        styles [
+          "flat",
+        ]
+      }
+
+      Gtk.MenuButton menu_button {
+        icon-name: "open-menu-symbolic";
+        menu-model: sidebar_menu;
+        tooltip-text: _("Main Menu");
+        can-focus: false;
+
+        styles [
+          "flat",
+        ]
+      }
+    }
+
+    // propagate-natural-width and overlay-scrolling both matter: without
+    // them the vertical scrollbar reserves layout width once there are
+    // enough tabs to scroll, making the rail wider than the configured width
+    // while the terminal's inset stays put -- so the rail creeps over the
+    // terminal.
+    Gtk.ScrolledWindow {
+      vexpand: true;
+      hscrollbar-policy: never;
+      propagate-natural-width: false;
+      overlay-scrolling: true;
+      min-content-width: 0;
+
+      // The model and factory are both installed from Zig. The model is the
+      // GtkSelectionModel that AdwTabView already maintains for its pages, so
+      // selection stays in sync with the tab view in both directions without
+      // any bookkeeping on our side.
+      //
+      // Not focusable on purpose: keyboard focus must stay in the terminal
+      // when you click a tab, the same way Ghostty's toolbar buttons set
+      // can-focus=false. Otherwise clicking the sidebar leaves you typing
+      // into a list instead of the shell.
+      //
+      // single-click-activate is deliberately left off: GTK documents it as
+      // "activate rows on single click and select them on hover", and the
+      // hover half of that would switch tabs just by moving the pointer.
+      // Deliberately *not* styled "navigation-sidebar". That class brings
+      // Adwaita's own row geometry with it -- `.navigation-sidebar > row`
+      // sets `padding: 0 8px` on top of listview insets -- which took the
+      // rail's content to 64px inside a 46px rail. GtkViewport centres what
+      // it cannot fit, so the whole column hung 9px off the left edge with
+      // the icons clipped. Overriding those rules from here did not stick,
+      // so the class is dropped and the rows are styled outright in
+      // style.css instead.
+      Gtk.ListView list_view {
+        focusable: false;
+      }
+      }
+    }
+  }
+}
+
+// The sidebar's own menu. Every entry targets an existing win.* or app.*
+// action, which resolve up the widget hierarchy to the window and
+// application, so nothing here reimplements behaviour.
+menu sidebar_menu {
+  section {
+    item {
+      label: _("New Tab");
+      action: "win.new-tab";
+    }
+
+    item {
+      label: _("Change Tab Title…");
+      action: "win.prompt-tab-title";
+    }
+
+    item {
+      label: _("Close Tab");
+      action: "win.close-tab";
+      target: "this";
+    }
+  }
+
+  section {
+    item {
+      label: _("View Open Tabs");
+      action: "win.toggle-tab-overview";
+    }
+
+    item {
+      label: _("Command Palette");
+      action: "win.toggle-command-palette";
+    }
+  }
+
+  // The sidebar's own settings live in a file it owns, so unlike the rest of
+  // Ghostty it can offer a dialog that writes them. The config entries stay:
+  // they are still where everything *else* is set, and where these options
+  // come from until the dialog overrides one.
+  section {
+    label: _("Sidebar");
+
+    item {
+      label: _("Sidebar Preferences…");
+      action: "sidebar.preferences";
+    }
+
+    item {
+      label: _("Open Configuration");
+      action: "app.open-config";
+    }
+
+    item {
+      label: _("Reload Configuration");
+      action: "app.reload-config";
+    }
+  }
+
+  section {
+    item {
+      label: _("New Window");
+      action: "win.new-window";
+    }
+
+    item {
+      label: _("About Ghostty");
+      action: "win.about";
+    }
+  }
+}
