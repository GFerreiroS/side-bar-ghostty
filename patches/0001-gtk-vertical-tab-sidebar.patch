+        // resolving a name collision, so recompute all of them.
+        self.refreshNames();
+    }
+
+    fn closePageData(self: *Self, obj: *gobject.Object) void {
+        const tab_view = self.private().tab_view orelse return;
+        const ptr = gobject.Object.getData(obj, key_page) orelse return;
+        const page: *adw.TabPage = @ptrCast(@alignCast(ptr));
