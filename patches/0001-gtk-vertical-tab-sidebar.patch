diff --git a/src/apprt/gtk/class/tab_sidebar.zig b/src/apprt/gtk/class/tab_sidebar.zig
new file mode 100644
index 0000000..14af76a
--- /dev/null
+++ b/src/apprt/gtk/class/tab_sidebar.zig
@@ -0,0 +1,1007 @@
+const std = @import("std");
+
+const adw = @import("adw");
+const gdk = @import("gdk");
+const glib = @import("glib");
+const gobject = @import("gobject");
+const gtk = @import("gtk");
+
+const gresource = @import("../build/gresource.zig");
+const Common = @import("../class.zig").Common;
+const Application = @import("application.zig").Application;
+const Config = @import("config.zig").Config;
+const Surface = @import("surface.zig").Surface;
+const Tab = @import("tab.zig").Tab;
+
+const log = std.log.scoped(.gtk_ghostty_tab_sidebar);
+
+/// A vertical list of the tabs in an `AdwTabView`, used as the window sidebar
+/// when `gtk-tabs-location` is `left` or `right`.
+///
+/// This is only a *consumer* of the existing tab model. `adw_tab_view_get_pages`
+/// hands back a `GtkSelectionModel` that AdwTabView keeps up to date, and
+/// giving that straight to a `GtkListView` makes selection track in both
+/// directions: clicking a row selects the tab, and selecting the tab elsewhere
+/// highlights the row. Nothing here duplicates tab state.
+///
+/// The sidebar rests collapsed as a narrow icon rail. Putting the pointer on
+/// it expands it over the terminal; leaving, typing, or clicking the terminal
+/// collapses it again. The expansion is an overlay, so the terminal never
+/// reflows.
+pub const TabSidebar = extern struct {
+    const Self = @This();
+    parent_instance: Parent,
+    pub const Parent = adw.Bin;
+    pub const getGObjectType = gobject.ext.defineClass(Self, .{
+        .name = "GhosttyTabSidebar",
+        .instanceInit = &init,
+        .classInit = &Class.init,
+        .parent_class = &Class.parent,
+        .private = .{ .Type = Private, .offset = &Private.offset },
+    });
+
+    /// Width of the collapsed icon rail and of the expanded list.
+    pub const rail_width: c_int = 46;
+    const expanded_width: c_int = 260;
+
+    /// Expanding is instant on pointer enter. Collapsing waits, so that
+    /// briefly leaving the sidebar -- crossing a gap, overshooting a row --
+    /// doesn't snap it shut under you.
+    const hover_collapse_ms: c_uint = 400;
+
+    /// Duration of the expand/collapse width animation.
+    const animation_ms: c_uint = 320;
+
+    /// Fraction of the slide that passes before labels begin to appear. The
+    /// same curve run backwards means they are gone well before the rail has
+    /// finished closing, so collapsing reads as a slide rather than the text
+    /// snapping out from under you.
+    const label_fade_start: f64 = 0.35;
+
+    /// Breathing room between the rail and the terminal. The rail reserves
+    /// its own width plus this, so terminal text never butts up against the
+    /// sidebar's edge -- the two occupy strictly separate space rather than
+    /// merely not overlapping.
+    const content_gap: f64 = 8;
+
+    /// Every icon sits in a fixed square of this size, in rows and in the
+    /// "New Tab" button alike. Aligning on a fixed box rather than on the
+    /// icon's own width is what keeps them in a column: symbolic icons do not
+    /// all report the same natural width, so margin arithmetic against a
+    /// nominal 16px drifts visibly between the "+" and the tab glyphs.
+    const icon_chip: c_int = 32;
+
+    // Centering is done entirely by the row/button margins in CSS, which are
+    // (rail_width - icon_chip) / 2 on each side. Nothing indents the icon a
+    // second time: doing that made the content need 39px inside a 32px chip,
+    // which both misaligned the "+" and pushed the rail wider than
+    // rail_width, so it overlapped the terminal.
+    comptime {
+        if (@rem(rail_width - icon_chip, 2) != 0) @compileError(
+            "rail_width - icon_chip must be even so the icon centers exactly",
+        );
+    }
+
+    /// How many parent directories we're willing to prepend to a tab name
+    /// while trying to make it unique.
+    const max_name_depth: usize = 8;
+
+    /// A realized row. GtkListView recycles rows, so these come and go as the
+    /// user scrolls; we track them to restyle and rename in place.
+    const Row = struct {
+        page: *adw.TabPage,
+        box: *gtk.Box,
+        text_box: *gtk.Box,
+        label: *gtk.Label,
+        close: *gtk.Button,
+
+        /// The surface we're watching for directory changes, and the handler
+        /// watching it. Without this a tab keeps its old folder name forever
+        /// after you cd.
+        surface: ?*Surface = null,
+        pwd_handler: c_ulong = 0,
+    };
+
+    const key_row_box = "ghostty-row-box";
+    const key_title_label = "ghostty-title-label";
+    const key_text_box = "ghostty-text-box";
+    const key_icon_image = "ghostty-icon-image";
+    const key_close_button = "ghostty-close-button";
+    const key_page = "ghostty-page";
+
+    pub const properties = struct {
+        /// Read-only: whether the sidebar is currently the narrow rail. The
+        /// window watches this to fade its scrim in and out.
+        pub const collapsed = struct {
+            pub const name = "collapsed";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                bool,
+                .{
+                    .default = true,
+                    .accessor = gobject.ext.typedAccessor(Self, bool, .{
+                        .getter = Self.isCollapsed,
+                    }),
+                },
+            );
+        };
+
+        pub const config = struct {
+            pub const name = "config";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                ?*Config,
+                .{ .accessor = C.privateObjFieldAccessor("config") },
+            );
+        };
+
+        pub const @"tab-view" = struct {
+            pub const name = "tab-view";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                ?*adw.TabView,
+                .{ .accessor = C.privateObjFieldAccessor("tab_view") },
+            );
+        };
+    };
+
+    const Private = struct {
+        config: ?*Config = null,
+        tab_view: ?*adw.TabView = null,
+
+        /// True while the sidebar is a narrow icon rail.
+        collapsed: bool = true,
+
+        /// Whether the sidebar is wanted at all. False with a single tab, in
+        /// which case the width animates to zero rather than vanishing.
+        active: bool = false,
+
+        /// Whether the "New Tab" row is wanted. Pushed in by the window from
+        /// `gtk-tabs-sidebar-new-button` rather than read from our own
+        /// `config` property: Window.init assigns its private `config` field
+        /// directly without emitting notify, so a blueprint
+        /// `config: bind template.config` binding never propagates here.
+        new_button_enabled: bool = true,
+
+        /// Pending collapse timer, running while the pointer is away.
+        hover_timer: ?c_uint = null,
+
+        /// Width animation and the width it is currently showing.
+        animation: ?*adw.TimedAnimation = null,
+        current_width: f64 = 0,
+
+        /// The content widget whose margin reserves room for the rail, and
+        /// which side the sidebar is on.
+        content: ?*gtk.Widget = null,
+        on_right: bool = false,
+
+        /// Last values pushed to the terminal's margin and to the labels.
+        /// The animation runs at frame rate, and re-applying these every
+        /// frame relaid out the terminal and re-mapped every label sixty
+        /// times a second, which is what made the slide stutter.
+        last_inset: c_int = -1,
+        last_labels_shown: bool = false,
+
+        /// Currently realized rows.
+        rows: std.ArrayListUnmanaged(Row) = .empty,
+
+        list_view: *gtk.ListView,
+        new_tab_button: *gtk.Button,
+        new_tab_label: *gtk.Label,
+        overview_button: *gtk.Button,
+        menu_button: *gtk.MenuButton,
+
+        pub var offset: c_int = 0;
+    };
+
+    //---------------------------------------------------------------
+    // Virtual Methods
+
+    fn init(self: *Self, _: *Class) callconv(.c) void {
+        gtk.Widget.initTemplate(self.as(gtk.Widget));
+
+        const priv = self.private();
+
+        // Build the row factory. We use a signal factory rather than a
+        // builder one because each row needs a close button wired back to a
+        // specific page, which a declarative list item template can't express.
+        const factory = gtk.SignalListItemFactory.new();
+        _ = gtk.SignalListItemFactory.signals.setup.connect(factory, *Self, &rowSetup, self, .{});
+        _ = gtk.SignalListItemFactory.signals.bind.connect(factory, *Self, &rowBind, self, .{});
+        _ = gtk.SignalListItemFactory.signals.unbind.connect(factory, *Self, &rowUnbind, self, .{});
+        priv.list_view.setFactory(factory.as(gtk.ListItemFactory));
+
+        // Width animation. The target writes straight into our size request.
+        const target = adw.CallbackAnimationTarget.new(&animationValue, self, null);
+        priv.animation = adw.TimedAnimation.new(
+            self.as(gtk.Widget),
+            0,
+            0,
+            animation_ms,
+            target.as(adw.AnimationTarget),
+        );
+
+        // Hide on `done` rather than trusting the width to reach zero. The
+        // widget's natural width can exceed its size request, so animating
+        // to zero does not necessarily shrink it to nothing -- which left
+        // the rail on screen after closing back down to a single tab.
+        _ = adw.Animation.signals.done.connect(
+            priv.animation.?.as(adw.Animation),
+            *Self,
+            &animationDone,
+            self,
+            .{},
+        );
+
+        // Expansion is driven by `motion`, not `enter`, on purpose. A sidebar
+        // that appears underneath a stationary pointer -- which is exactly
+        // what happens when opening a second tab from the rail -- receives an
+        // enter event immediately and would fling itself open. Requiring
+        // actual pointer movement means it only opens when you really move
+        // onto it.
+        const motion = gtk.EventControllerMotion.new();
+        _ = gtk.EventControllerMotion.signals.motion.connect(motion, *Self, &hoverEnter, self, .{});
+        _ = gtk.EventControllerMotion.signals.leave.connect(motion, *Self, &hoverLeave, self, .{});
+        self.as(gtk.Widget).addController(motion.as(gtk.EventController));
+
+        _ = gobject.Object.signals.notify.connect(
+            self,
+            ?*anyopaque,
+            propTabView,
+            null,
+            .{ .detail = "tab-view" },
+        );
+
+        _ = gobject.Object.signals.notify.connect(
+            priv.menu_button,
+            *Self,
+            &menuActive,
+            self,
+            .{ .detail = "active" },
+        );
+
+        self.as(gtk.Widget).setVisible(0);
+        self.applyCollapsed();
+    }
+
+    fn dispose(self: *Self) callconv(.c) void {
+        const priv = self.private();
+
+        self.cancelHoverTimer();
+        for (priv.rows.items) |row| {
+            if (row.surface) |s| {
+                if (row.pwd_handler != 0) {
+                    gobject.signalHandlerDisconnect(s.as(gobject.Object), row.pwd_handler);
+                }
+            }
+        }
+        priv.rows.deinit(Application.default().allocator());
+
+        if (priv.config) |config| {
+            config.unref();
+            priv.config = null;
+        }
+        if (priv.tab_view) |tab_view| {
+            tab_view.unref();
+            priv.tab_view = null;
+        }
+
+        gtk.Widget.disposeTemplate(self.as(gtk.Widget), getGObjectType());
+        gobject.Object.virtual_methods.dispose.call(Class.parent, self.as(Parent));
+    }
+
+    //---------------------------------------------------------------
+    // Collapse / Expand
+
+    pub fn isCollapsed(self: *Self) bool {
+        return self.private().collapsed;
+    }
+
+    /// Collapse the sidebar back to the icon rail. Called by the window when
+    /// the user types or clicks the terminal, and when the pointer leaves.
+    pub fn collapse(self: *Self) void {
+        self.cancelHoverTimer();
+        self.setCollapsed(true);
+    }
+
+    /// Whether the sidebar should exist at all. Driven by the window from tab
+    /// count; going inactive slides the rail out rather than snapping it
+    /// away, which is what makes closing your second-to-last tab animate.
+    pub fn setActive(self: *Self, active: bool) void {
+        const priv = self.private();
+        if (priv.active == active) return;
+        priv.active = active;
+
+        // Must be visible before it can animate in.
+        if (active) self.as(gtk.Widget).setVisible(1);
+
+        // Coming back always starts from the rail, never mid-expansion. This
+        // goes through setCollapsed rather than writing the field so that
+        // notify::collapsed still fires -- otherwise a sidebar that was open
+        // when the second-to-last tab closed would leave the window's scrim
+        // switched on with nothing to dim.
+        if (!active) {
+            self.cancelHoverTimer();
+            self.setCollapsed(true);
+        }
+        self.applyCollapsed();
+    }
+
+    /// The content widget we inset to make room for the rail.
+    pub fn setContentInset(self: *Self, content: *gtk.Widget, on_right: bool) void {
+        const priv = self.private();
+        priv.content = content;
+        priv.on_right = on_right;
+
+        // The hairline goes on whichever edge faces the terminal.
+        self.toggleCssClass("sidebar-right", on_right);
+
+        self.applyInset(priv.current_width);
+    }
+
+    /// Set by the window from `gtk-tabs-sidebar-new-button`.
+    pub fn setNewButtonEnabled(self: *Self, enabled: bool) void {
+        const priv = self.private();
+        priv.new_button_enabled = enabled;
+        priv.new_tab_button.as(gtk.Widget).setVisible(@intFromBool(enabled));
+    }
+
+    fn setCollapsed(self: *Self, collapsed: bool) void {
+        const priv = self.private();
+        if (priv.collapsed == collapsed) return;
+        priv.collapsed = collapsed;
+        self.applyCollapsed();
+
+        self.as(gobject.Object).notifyByPspec(
+            properties.collapsed.impl.param_spec,
+        );
+    }
+
+    fn targetWidth(self: *Self) f64 {
+        const priv = self.private();
+        if (!priv.active) return 0;
+        return @floatFromInt(if (priv.collapsed) rail_width else expanded_width);
+    }
+
+    fn applyCollapsed(self: *Self) void {
+        const priv = self.private();
+        const collapsed = priv.collapsed;
+
+        self.animateWidth(self.targetWidth());
+        self.toggleCssClass("collapsed", collapsed);
+
+        priv.new_tab_button.as(gtk.Widget).setVisible(
+            @intFromBool(priv.new_button_enabled),
+        );
+    }
+
+    /// How visible labels should be at the given sidebar width. Tying this to
+    /// the animated width rather than to the collapsed flag is what keeps the
+    /// text and the rail in step.
+    fn labelOpacity(width: f64) f64 {
+        const rail: f64 = @floatFromInt(rail_width);
+        const open: f64 = @floatFromInt(expanded_width);
+        if (open <= rail) return 1;
+
+        const progress = std.math.clamp((width - rail) / (open - rail), 0, 1);
+        return std.math.clamp(
+            (progress - label_fade_start) / (1 - label_fade_start),
+            0,
+            1,
+        );
+    }
+
+    /// Fade every label and close button to match the current width. They are
+    /// only actually hidden once fully transparent -- at rail width the row
+    /// has no room for them, and leaving them mapped would squeeze the icon.
+    fn applyLabelFade(self: *Self, width: f64) void {
+        const priv = self.private();
+        const opacity = labelOpacity(width);
+
+        // Visibility triggers a relayout, so only touch it when it actually
+        // flips. Opacity alone is a cheap redraw.
+        const shown = opacity > 0.01;
+        const flipped = shown != priv.last_labels_shown;
+        priv.last_labels_shown = shown;
+        const vis: c_int = @intFromBool(shown);
+
+        for (priv.rows.items) |row| {
+            const text = row.text_box.as(gtk.Widget);
+            const close = row.close.as(gtk.Widget);
+            text.setOpacity(opacity);
+            close.setOpacity(opacity);
+            if (flipped) {
+                text.setVisible(vis);
+                close.setVisible(vis);
+            }
+        }
+
+        const label = priv.new_tab_label.as(gtk.Widget);
+        label.setOpacity(opacity);
+
+        // The overview and menu buttons live in the same row as "New Tab".
+        // They only exist once there is room for them, and the "+" gives up
+        // its width to make space rather than the row rearranging.
+        const overview = priv.overview_button.as(gtk.Widget);
+        const menu = priv.menu_button.as(gtk.Widget);
+        overview.setOpacity(opacity);
+        menu.setOpacity(opacity);
+
+        if (flipped) {
+            label.setVisible(vis);
+            overview.setVisible(vis);
+            menu.setVisible(vis);
+        }
+    }
+
+    /// Animate the sidebar width to `target`, starting from wherever the
+    /// current animation left off so that a reversal mid-slide is smooth
+    /// rather than jumping.
+    fn animateWidth(self: *Self, target: f64) void {
+        const priv = self.private();
+
+        const anim = priv.animation orelse {
+            priv.current_width = target;
+            self.as(gtk.Widget).setSizeRequest(@intFromFloat(target), -1);
+            self.applyInset(target);
+            self.applyLabelFade(target);
+            return;
+        };
+
+        anim.as(adw.Animation).skip();
+        anim.setValueFrom(priv.current_width);
+        anim.setValueTo(target);
+        anim.as(adw.Animation).play();
+    }
+
+    fn animationDone(_: *adw.Animation, self: *Self) callconv(.c) void {
+        if (self.private().active) return;
+        self.as(gtk.Widget).setVisible(0);
+    }
+
+    fn animationValue(value: f64, ud: ?*anyopaque) callconv(.c) void {
+        const self: *Self = @ptrCast(@alignCast(ud orelse return));
+        const priv = self.private();
+        priv.current_width = value;
+        self.as(gtk.Widget).setSizeRequest(@intFromFloat(value), -1);
+        self.applyInset(value);
+        self.applyLabelFade(value);
+
+        // setSizeRequest only sets a *minimum*; the rail's natural width
+        // would keep it on screen at the end of the slide-out. Hide it once
+        // the animation has actually reached zero.
+        if (!priv.active and value < 1) self.as(gtk.Widget).setVisible(0);
+    }
+
+    /// Inset the content by the *rail* width, never more. Expanding past the
+    /// rail overlays the terminal instead of pushing it, so the margin stays
+    /// put; sliding the rail out to zero takes the margin with it, so the
+    /// terminal reclaims the space in step with the animation.
+    fn applyInset(self: *Self, width: f64) void {
+        const priv = self.private();
+        const content = priv.content orelse return;
+
+        const rail: f64 = @floatFromInt(rail_width);
+        const reserved = @min(width, rail);
+
+        // The gap fades in with the rail rather than being added flat, so
+        // sliding out to nothing does not leave an 8px ledge behind at the
+        // last frame.
+        const inset: c_int = @intFromFloat(
+            reserved + (reserved / rail) * content_gap,
+        );
+
+        // Expanding past the rail never changes the inset, so most frames of
+        // a slide have nothing to do here. Skipping them keeps the terminal
+        // from being relaid out on every frame.
+        if (inset == priv.last_inset) return;
+        priv.last_inset = inset;
+
+        content.setMarginStart(if (priv.on_right) 0 else inset);
+        content.setMarginEnd(if (priv.on_right) inset else 0);
+    }
+
+    fn toggleCssClass(self: *Self, name: [*:0]const u8, present: bool) void {
+        const widget = self.as(gtk.Widget);
+        if (present) {
+            widget.addCssClass(name);
+        } else {
+            widget.removeCssClass(name);
+        }
+    }
+
+    fn cancelHoverTimer(self: *Self) void {
+        const priv = self.private();
+        if (priv.hover_timer) |id| {
+            if (glib.Source.remove(id) == 0) {
+                log.warn("failed to remove hover timer id={}", .{id});
+            }
+            priv.hover_timer = null;
+        }
+    }
+
+    fn hoverEnter(
+        _: *gtk.EventControllerMotion,
+        _: f64,
+        _: f64,
+        self: *Self,
+    ) callconv(.c) void {
+        // Expanding is instant: any pending collapse is abandoned.
+        self.cancelHoverTimer();
+        if (self.private().active) self.setCollapsed(false);
+    }
+
+    fn hoverLeave(_: *gtk.EventControllerMotion, self: *Self) callconv(.c) void {
+        self.armCollapse();
+    }
+
+    /// Start the collapse countdown, unless the menu is open. Opening the
+    /// menu moves the pointer onto its popover, which reads as leaving the
+    /// sidebar -- collapsing it out from under the menu you just opened.
+    fn armCollapse(self: *Self) void {
+        const priv = self.private();
+        if (priv.collapsed) return;
+        if (priv.menu_button.getActive() != 0) return;
+
+        self.cancelHoverTimer();
+        priv.hover_timer = glib.timeoutAdd(hover_collapse_ms, hoverTimer, self);
+    }
+
+    fn menuActive(
+        menu: *gtk.MenuButton,
+        _: *gobject.ParamSpec,
+        self: *Self,
+    ) callconv(.c) void {
+        if (menu.getActive() != 0) {
+            // Menu opening: hold the sidebar open for as long as it is up.
+            self.cancelHoverTimer();
+            return;
+        }
+
+        // Menu dismissed: resume the normal countdown.
+        self.armCollapse();
+    }
+
+    fn hoverTimer(ud: ?*anyopaque) callconv(.c) c_int {
+        const self: *Self = @ptrCast(@alignCast(ud orelse return 0));
+        self.private().hover_timer = null;
+        self.setCollapsed(true);
+        return 0;
+    }
+
+    //---------------------------------------------------------------
+    // Properties
+
+    fn propTabView(self: *Self, _: *gobject.ParamSpec, _: ?*anyopaque) callconv(.c) void {
+        const priv = self.private();
+
+        const tab_view = priv.tab_view orelse {
+            priv.list_view.setModel(null);
+            return;
+        };
+
+        // The pages model is already a GtkSelectionModel maintained by
+        // AdwTabView, so handing it over is all the wiring selection needs.
+        // We own a reference from getPages and the list view takes its own.
+        const model = tab_view.getPages();
+        defer model.unref();
+        priv.list_view.setModel(model);
+    }
+
+    //---------------------------------------------------------------
+    // Naming
+    //
+    // A tab is labelled with just its folder name. When two tabs would show
+    // the same name we prepend parent directories to each, one level at a
+    // time, until they differ -- the way editors disambiguate same-named
+    // files. When the paths are genuinely identical (two shells in one
+    // directory) no amount of path helps, so we fall back to the terminal
+    // title, which with shell integration is usually the running command.
+
+    fn pageSurface(page: *adw.TabPage) ?*Surface {
+        const tab = gobject.ext.cast(Tab, page.getChild()) orelse return null;
+        return tab.getActiveSurface();
+    }
+
+    fn pagePwd(page: *adw.TabPage) ?[:0]const u8 {
+        const surface = pageSurface(page) orelse return null;
+        return surface.getPwd();
+    }
+
+    fn pageTitle(page: *adw.TabPage) ?[:0]const u8 {
+        const surface = pageSurface(page) orelse return null;
+        return surface.getTitle();
+    }
+
+    /// The trailing `n` path components of `path`.
+    fn tailComponents(path: []const u8, n: usize) []const u8 {
+        var end = path.len;
+        while (end > 1 and path[end - 1] == '/') end -= 1;
+        if (end == 0) return path;
+
+        var seen: usize = 0;
+        var i = end;
+        while (i > 0) {
+            i -= 1;
+            if (path[i] == '/') {
+                seen += 1;
+                if (seen == n) return path[i + 1 .. end];
+            }
+        }
+        return path[0..end];
+    }
+
+    fn trimmedLen(path: []const u8) usize {
+        var end = path.len;
+        while (end > 1 and path[end - 1] == '/') end -= 1;
+        return end;
+    }
+
+    fn canGrow(path: []const u8, n: usize) bool {
+        return tailComponents(path, n).len < trimmedLen(path);
+    }
+
+    /// Recompute every realized row's label and tooltip.
+    fn refreshNames(self: *Self) void {
+        const priv = self.private();
+        const tab_view = priv.tab_view orelse return;
+        if (priv.rows.items.len == 0) return;
+
+        const n = tab_view.getNPages();
+        if (n <= 0) return;
+        const count: usize = @intCast(n);
+
+        const alloc = Application.default().allocator();
+        const paths = alloc.alloc(?[:0]const u8, count) catch return;
+        defer alloc.free(paths);
+        const depths = alloc.alloc(usize, count) catch return;
+        defer alloc.free(depths);
+
+        for (0..count) |i| {
+            paths[i] = pagePwd(tab_view.getNthPage(@intCast(i)));
+            depths[i] = 1;
+        }
+
+        // Grow colliding names until they differ or we run out of path.
+        var round: usize = 0;
+        while (round < max_name_depth) : (round += 1) {
+            var changed = false;
+            for (0..count) |i| {
+                const pi = paths[i] orelse continue;
+                for (i + 1..count) |j| {
+                    const pj = paths[j] orelse continue;
+                    // Identical paths can never be told apart by path.
+                    if (std.mem.eql(u8, pi, pj)) continue;
+                    if (!std.mem.eql(
+                        u8,
+                        tailComponents(pi, depths[i]),
+                        tailComponents(pj, depths[j]),
+                    )) continue;
+
+                    if (canGrow(pi, depths[i])) {
+                        depths[i] += 1;
+                        changed = true;
+                    }
+                    if (canGrow(pj, depths[j])) {
+                        depths[j] += 1;
+                        changed = true;
+                    }
+                }
+            }
+            if (!changed) break;
+        }
+
+        for (priv.rows.items) |row| {
+            const idx = pageIndex(tab_view, row.page) orelse continue;
+            const path = paths[idx];
+
+            // Does another tab share this exact path? Then disambiguate with
+            // the terminal title instead.
+            var duplicate_path = false;
+            if (path) |p| {
+                for (0..count) |k| {
+                    if (k == idx) continue;
+                    const other = paths[k] orelse continue;
+                    if (std.mem.eql(u8, p, other)) {
+                        duplicate_path = true;
+                        break;
+                    }
+                }
+            }
+
+            applyRowName(row, path, depths[idx], duplicate_path);
+        }
+    }
+
+    fn applyRowName(
+        row: Row,
+        path: ?[:0]const u8,
+        depth: usize,
+        duplicate_path: bool,
+    ) void {
+        const alloc = Application.default().allocator();
+
+        const p = path orelse {
+            // No working directory known; fall back to the page title.
+            const t = row.page.getTitle();
+            row.label.setText(t);
+            row.box.as(gtk.Widget).setTooltipText(t);
+            return;
+        };
+
+        const short = tailComponents(p, depth);
+
+        const label_text: [:0]const u8 = if (duplicate_path) blk: {
+            const title = pageTitle(row.page) orelse
+                break :blk alloc.dupeZ(u8, short) catch return;
+            break :blk std.fmt.allocPrintSentinel(
+                alloc,
+                "{s} — {s}",
+                .{ short, title },
+                0,
+            ) catch return;
+        } else alloc.dupeZ(u8, short) catch return;
+        defer alloc.free(label_text);
+
+        row.label.setText(label_text);
+
+        // The tooltip always carries the full path, so a grown or truncated
+        // name never hides where the tab actually is.
+        row.box.as(gtk.Widget).setTooltipText(p);
+    }
+
+    fn pageIndex(tab_view: *adw.TabView, page: *adw.TabPage) ?usize {
+        const n = tab_view.getNPages();
+        var i: c_int = 0;
+        while (i < n) : (i += 1) {
+            if (tab_view.getNthPage(i) == page) return @intCast(i);
+        }
+        return null;
+    }
+
+    //---------------------------------------------------------------
+    // Row Factory
+
+    fn rowSetup(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+
+        // No margins on the row box at all. The chip's own margins centre it
+        // in the rail; anything here would be added on top of that and push
+        // the content wider than the rail.
+        const box = gtk.Box.new(.horizontal, 6);
+
+        const icon = gtk.Image.newFromIconName("utilities-terminal-symbolic");
+        icon.as(gtk.Widget).setSizeRequest(icon_chip, icon_chip);
+        box.append(icon.as(gtk.Widget));
+
+        // The title sits in a vertical box with room for a second line. That
+        // slot is unused today; it's where per-tab git branch would go
+        // without having to relayout the row.
+        const text_box = gtk.Box.new(.vertical, 0);
+        text_box.as(gtk.Widget).setHexpand(1);
+        const title = gtk.Label.new(null);
+        title.setXalign(0);
+        title.setEllipsize(.end);
+        title.setSingleLineMode(1);
+        text_box.append(title.as(gtk.Widget));
+        box.append(text_box.as(gtk.Widget));
+
+        const close = gtk.Button.newFromIconName("window-close-symbolic");
+        close.as(gtk.Widget).addCssClass("flat");
+        close.as(gtk.Widget).addCssClass("circular");
+        close.as(gtk.Widget).setFocusOnClick(0);
+        _ = gtk.Button.signals.clicked.connect(close, *Self, &rowCloseClicked, self, .{});
+        box.append(close.as(gtk.Widget));
+
+        // Middle click closes the tab, as it does in a browser tab strip.
+        // This works in rail mode too, where the close button is hidden.
+        const middle = gtk.GestureClick.new();
+        middle.as(gtk.GestureSingle).setButton(gdk.BUTTON_MIDDLE);
+        _ = gtk.GestureClick.signals.pressed.connect(
+            middle,
+            *Self,
+            &rowMiddleClick,
+            self,
+            .{},
+        );
+        box.as(gtk.Widget).addController(middle.as(gtk.EventController));
+
+        const obj = list_item.as(gobject.Object);
+        gobject.Object.setData(obj, key_row_box, box);
+        gobject.Object.setData(obj, key_title_label, title);
+        gobject.Object.setData(obj, key_text_box, text_box);
+        gobject.Object.setData(obj, key_icon_image, icon);
+        gobject.Object.setData(obj, key_close_button, close);
+
+        list_item.setChild(box.as(gtk.Widget));
+    }
+
+    fn rowBind(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+        const obj = list_item.as(gobject.Object);
+
+        const item = list_item.getItem() orelse return;
+        const page = gobject.ext.cast(adw.TabPage, item) orelse return;
+
+        const box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_row_box) orelse return,
+        ));
+        const label: *gtk.Label = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_title_label) orelse return,
+        ));
+        const text_box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_text_box) orelse return,
+        ));
+        const close: *gtk.Button = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_close_button) orelse return,
+        ));
+
+        gobject.Object.setData(close.as(gobject.Object), key_page, page);
+        gobject.Object.setData(box.as(gobject.Object), key_page, page);
+
+        // Watch this tab's directory so the label follows a cd.
+        var surface: ?*Surface = null;
+        var pwd_handler: c_ulong = 0;
+        if (pageSurface(page)) |s| {
+            surface = s;
+            pwd_handler = gobject.Object.signals.notify.connect(
+                s,
+                *Self,
+                &surfacePwdChanged,
+                self,
+                .{ .detail = "pwd" },
+            );
+        }
+
+        const priv = self.private();
+        priv.rows.append(Application.default().allocator(), .{
+            .page = page,
+            .box = box,
+            .text_box = text_box,
+            .label = label,
+            .close = close,
+            .surface = surface,
+            .pwd_handler = pwd_handler,
+        }) catch return;
+
+        // A row realized mid-animation has to match the fade already in
+        // progress, not the end state.
+        self.applyLabelFade(priv.current_width);
+
+        self.refreshNames();
+    }
+
+    fn rowUnbind(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+        const obj = list_item.as(gobject.Object);
+
+        const box = gobject.Object.getData(obj, key_row_box) orelse return;
+        const priv = self.private();
+        for (priv.rows.items, 0..) |row, i| {
+            if (@intFromPtr(row.box) == @intFromPtr(box)) {
+                if (row.surface) |s| {
+                    if (row.pwd_handler != 0) {
+                        gobject.signalHandlerDisconnect(
+                            s.as(gobject.Object),
+                            row.pwd_handler,
+                        );
+                    }
+                }
+                _ = priv.rows.swapRemove(i);
+                break;
+            }
+        }
+
+        // Drop the page pointers so a recycled row can never act on the tab
+        // it used to be showing.
+        if (gobject.Object.getData(obj, key_close_button)) |ptr| {
+            const c: *gtk.Button = @ptrCast(@alignCast(ptr));
+            gobject.Object.setData(c.as(gobject.Object), key_page, null);
+        }
+        if (gobject.Object.getData(obj, key_row_box)) |ptr| {
+            const b: *gtk.Box = @ptrCast(@alignCast(ptr));
+            gobject.Object.setData(b.as(gobject.Object), key_page, null);
+        }
+    }
+
+    //---------------------------------------------------------------
+    // Signal Handlers
+
+    fn surfacePwdChanged(
+        _: *Surface,
+        _: *gobject.ParamSpec,
+        self: *Self,
+    ) callconv(.c) void {
