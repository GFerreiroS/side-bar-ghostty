@@ -0,0 +1,1832 @@
+const std = @import("std");
+
+const adw = @import("adw");
+const gdk = @import("gdk");
+const gio = @import("gio");
+const glib = @import("glib");
+const gobject = @import("gobject");
+const gtk = @import("gtk");
+
+const configpkg = @import("../../../config.zig");
+const gresource = @import("../build/gresource.zig");
+const Common = @import("../class.zig").Common;
+const Settings = @import("../tab_sidebar_settings.zig");
+const git = @import("../tab_sidebar_git.zig");
+const prefs = @import("../tab_sidebar_prefs.zig");
+const Application = @import("application.zig").Application;
+const Config = @import("config.zig").Config;
+const Surface = @import("surface.zig").Surface;
+const Tab = @import("tab.zig").Tab;
+
+const log = std.log.scoped(.gtk_ghostty_tab_sidebar);
+
+/// A vertical list of the tabs in an `AdwTabView`, used as the window sidebar
+/// when `gtk-tabs-location` is `left` or `right`.
+///
+/// This is only a *consumer* of the existing tab model. `adw_tab_view_get_pages`
+/// hands back a `GtkSelectionModel` that AdwTabView keeps up to date, and
+/// giving that straight to a `GtkListView` makes selection track in both
+/// directions: clicking a row selects the tab, and selecting the tab elsewhere
+/// highlights the row. Nothing here duplicates tab state.
+///
+/// The sidebar rests collapsed as a narrow icon rail. Putting the pointer on
+/// it expands it over the terminal; leaving, typing, or clicking the terminal
+/// collapses it again. The expansion is an overlay, so the terminal never
+/// reflows.
+pub const TabSidebar = extern struct {
+    const Self = @This();
+    parent_instance: Parent,
+    pub const Parent = adw.Bin;
+    pub const getGObjectType = gobject.ext.defineClass(Self, .{
+        .name = "GhosttyTabSidebar",
+        .instanceInit = &init,
+        .classInit = &Class.init,
+        .parent_class = &Class.parent,
+        .private = .{ .Type = Private, .offset = &Private.offset },
+    });
+
+    // Widths, timings and the icon chip size all live in `priv.settings` --
+    // see `tab_sidebar_settings.zig`. They were constants until they became
+    // configurable; the notes those constants carried are kept with the
+    // options in `Config.zig`, and with the geometry rules in
+    // `Settings.normalize`, which is where the old `comptime` assertion that
+    // the icon can be centred now lives.
+    //
+    // Two things stayed fixed, because neither is a matter of taste:
+
+    /// Extra inset on the terminal beyond the rail's own width. Zero: the
+    /// breathing room is inside the rail width now, painted in the sidebar's
+    /// own colour, so nothing shows through between the two.
+    const content_gap: f64 = 0;
+
+    /// How many parent directories we're willing to prepend to a tab name
+    /// while trying to make it unique.
+    const max_name_depth: usize = 8;
+
+    /// A realized row. GtkListView recycles rows, so these come and go as the
+    /// user scrolls; we track them to restyle and rename in place.
+    const Row = struct {
+        page: *adw.TabPage,
+        box: *gtk.Box,
+        text_box: *gtk.Box,
+        label: *gtk.Label,
+        icon: *gtk.Image,
+        close: *gtk.Button,
+
+        /// Second line: the branch, then whatever the subtitle setting asks
+        /// for. Both live in one box so the line disappears whole when
+        /// neither has anything to say.
+        subtitle_box: *gtk.Box,
+        branch_label: *gtk.Label,
+        subtitle_label: *gtk.Label,
+
+        /// Status icons, shown between the text and the close button.
+        indicator_box: *gtk.Box,
+        bell_icon: *gtk.Image,
+        readonly_icon: *gtk.Image,
+
+        /// Whether this row has an indicator to show *at all*. Actually
+        /// showing it needs the sidebar expanded as well: the icons sit in
+        /// the row box, and on the rail that box has to measure exactly one
+        /// chip across or the rail grows and creeps over the terminal.
+        wants_indicators: bool = false,
+
+        /// The surface we're watching, and every handler watching it.
+        /// Without the pwd one a tab keeps its old folder name forever after
+        /// you cd; the rest keep the second line and the indicators honest.
+        surface: ?*Surface = null,
+        handlers: [4]c_ulong = @splat(0),
+
+        /// The repository's `HEAD` for this tab's directory, the monitor
+        /// watching it, and the branch last read out of it.
+        ///
+        /// A monitor rather than a poll: `HEAD` is rewritten by every
+        /// checkout, so the kernel already knows the answer changed and there
+        /// is nothing to poll for in between.
+        head_path: ?[:0]u8 = null,
+        head_monitor: ?*gio.FileMonitor = null,
+        head_handler: c_ulong = 0,
+        branch: ?[]u8 = null,
+
+        /// Free everything the row owns. The widgets are not ours -- GTK owns
+        /// the recycled row -- but the strings and the monitor are.
+        fn deinit(self: *Row, alloc: std.mem.Allocator) void {
+            if (self.surface) |s| {
+                for (self.handlers) |h| {
+                    if (h != 0) gobject.signalHandlerDisconnect(s.as(gobject.Object), h);
+                }
+            }
+            self.surface = null;
+            self.handlers = @splat(0);
+
+            if (self.head_monitor) |m| {
+                if (self.head_handler != 0) {
+                    gobject.signalHandlerDisconnect(m.as(gobject.Object), self.head_handler);
+                }
+                _ = m.cancel();
+                m.unref();
+                self.head_monitor = null;
+                self.head_handler = 0;
+            }
+            if (self.head_path) |p| alloc.free(p);
+            if (self.branch) |b| alloc.free(b);
+            self.head_path = null;
+            self.branch = null;
+        }
+    };
+
+    const key_row_box = "ghostty-row-box";
+    const key_title_label = "ghostty-title-label";
+    const key_text_box = "ghostty-text-box";
+    const key_icon_image = "ghostty-icon-image";
+    const key_close_button = "ghostty-close-button";
+    const key_subtitle_box = "ghostty-subtitle-box";
+    const key_branch_label = "ghostty-branch-label";
+    const key_subtitle_label = "ghostty-subtitle-label";
+    const key_indicator_box = "ghostty-indicator-box";
+    const key_bell_icon = "ghostty-bell-icon";
+    const key_readonly_icon = "ghostty-readonly-icon";
+    const key_page = "ghostty-page";
+
+    pub const properties = struct {
+        /// Read-only: whether the sidebar is currently the narrow rail. The
+        /// window watches this to fade its scrim in and out.
+        pub const collapsed = struct {
+            pub const name = "collapsed";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                bool,
+                .{
+                    .default = true,
+                    .accessor = gobject.ext.typedAccessor(Self, bool, .{
+                        .getter = Self.isCollapsed,
+                    }),
+                },
+            );
+        };
+
+        pub const config = struct {
+            pub const name = "config";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                ?*Config,
+                .{ .accessor = C.privateObjFieldAccessor("config") },
+            );
+        };
+
+        pub const @"tab-view" = struct {
+            pub const name = "tab-view";
+            const impl = gobject.ext.defineProperty(
+                name,
+                Self,
+                ?*adw.TabView,
+                .{ .accessor = C.privateObjFieldAccessor("tab_view") },
+            );
+        };
+    };
+
+    const Private = struct {
+        config: ?*Config = null,
+        tab_view: ?*adw.TabView = null,
+
+        /// Everything the sidebar's own look and feel is driven by. Starts at
+        /// the field defaults so the widget is usable before the window has
+        /// pushed anything in, then follows `gtk-tabs-sidebar-*` layered with
+        /// the sidebar's own `sidebar.conf`.
+        ///
+        /// The window pushes these in via `setSettings` rather than the
+        /// sidebar reading its own `config` property: `Window.init` assigns
+        /// its private `config` field directly without emitting notify, so a
+        /// blueprint `config: bind template.config` binding never propagates
+        /// here and the config would stay null forever.
+        settings: Settings = .{},
+
+        /// What the settings would be with `sidebar.conf` removed: the field
+        /// defaults with the user's `gtk-tabs-sidebar-*` config on top. This
+        /// is what the preferences dialog's reset button goes back to, which
+        /// is why it is not simply `Settings{}` -- a config option the user
+        /// wrote by hand is not something "reset" should discard.
+        baseline: Settings = .{},
+
+        /// True while the sidebar is a narrow icon rail.
+        collapsed: bool = true,
+
+        /// Whether the sidebar is wanted at all. False with a single tab, in
+        /// which case the width animates to zero rather than vanishing.
+        active: bool = false,
+
+        /// Stylesheet generated from `settings`, holding everything CSS has
+        /// to own: the corner radius, and the margins that centre the icon
+        /// chips. Added to the display rather than the widget, because GTK4
+        /// has no per-widget providers.
+        css_provider: ?*gtk.CssProvider = null,
+
+        /// Cached; see `iconTheme`.
+        icon_theme: ?*gtk.IconTheme = null,
+
+        /// The images we put inside the overview and menu buttons, kept so
+        /// their box can be resized when the sidebar opens or closes.
+        overview_icon: ?*gtk.Image = null,
+        menu_icon: ?*gtk.Image = null,
+
+        /// Pending collapse timer, running while the pointer is away.
+        hover_timer: ?c_uint = null,
+
+        /// Width animation and the width it is currently showing.
+        animation: ?*adw.TimedAnimation = null,
+        current_width: f64 = 0,
+
+        /// The content widget whose margin reserves room for the rail, and
+        /// which side the sidebar is on.
+        content: ?*gtk.Widget = null,
+        on_right: bool = false,
+
+        /// Last values pushed to the terminal's margin and to the labels.
+        /// The animation runs at frame rate, and re-applying these every
+        /// frame relaid out the terminal and re-mapped every label sixty
+        /// times a second, which is what made the slide stutter.
+        last_inset: c_int = -1,
+
+        /// Whether the expanded-only content is currently mapped. Not simply
+        /// `!collapsed`: it is set true as soon as expanding starts and false
+        /// only once collapsing has finished, so the row never changes size
+        /// mid-slide.
+        content_shown: bool = false,
+
+
+        /// Currently realized rows.
+        rows: std.ArrayListUnmanaged(Row) = .empty,
+
+        list_view: *gtk.ListView,
+        top_bar: *gtk.Box,
+        new_tab_button: *gtk.Button,
+        new_tab_box: *gtk.Box,
+        new_tab_icon: *gtk.Image,
+        new_tab_label: *gtk.Label,
+        overview_button: *gtk.Button,
+        menu_button: *gtk.MenuButton,
+
+        pub var offset: c_int = 0;
+    };
+
+    //---------------------------------------------------------------
+    // Virtual Methods
+
+    fn init(self: *Self, _: *Class) callconv(.c) void {
+        gtk.Widget.initTemplate(self.as(gtk.Widget));
+
+        const priv = self.private();
+
+        // Build the row factory. We use a signal factory rather than a
+        // builder one because each row needs a close button wired back to a
+        // specific page, which a declarative list item template can't express.
+        const factory = gtk.SignalListItemFactory.new();
+        _ = gtk.SignalListItemFactory.signals.setup.connect(factory, *Self, &rowSetup, self, .{});
+        _ = gtk.SignalListItemFactory.signals.bind.connect(factory, *Self, &rowBind, self, .{});
+        _ = gtk.SignalListItemFactory.signals.unbind.connect(factory, *Self, &rowUnbind, self, .{});
+        priv.list_view.setFactory(factory.as(gtk.ListItemFactory));
+
+        // Width animation. The target writes straight into our size request.
+        const target = adw.CallbackAnimationTarget.new(&animationValue, self, null);
+        priv.animation = adw.TimedAnimation.new(
+            self.as(gtk.Widget),
+            0,
+            0,
+            priv.settings.animation_duration,
+            target.as(adw.AnimationTarget),
+        );
+
+        // Hide on `done` rather than trusting the width to reach zero. The
+        // widget's natural width can exceed its size request, so animating
+        // to zero does not necessarily shrink it to nothing -- which left
+        // the rail on screen after closing back down to a single tab.
+        _ = adw.Animation.signals.done.connect(
+            priv.animation.?.as(adw.Animation),
+            *Self,
+            &animationDone,
+            self,
+            .{},
+        );
+
+        // Expansion is driven by `motion`, not `enter`, on purpose. A sidebar
+        // that appears underneath a stationary pointer -- which is exactly
+        // what happens when opening a second tab from the rail -- receives an
+        // enter event immediately and would fling itself open. Requiring
+        // actual pointer movement means it only opens when you really move
+        // onto it.
+        const motion = gtk.EventControllerMotion.new();
+        _ = gtk.EventControllerMotion.signals.motion.connect(motion, *Self, &hoverEnter, self, .{});
+        _ = gtk.EventControllerMotion.signals.enter.connect(motion, *Self, &hoverEnter, self, .{});
+        _ = gtk.EventControllerMotion.signals.leave.connect(motion, *Self, &hoverLeave, self, .{});
+        self.as(gtk.Widget).addController(motion.as(gtk.EventController));
+
+        _ = gobject.Object.signals.notify.connect(
+            self,
+            ?*anyopaque,
+            propTabView,
+            null,
+            .{ .detail = "tab-view" },
+        );
+
+        _ = gobject.Object.signals.notify.connect(
+            priv.menu_button,
+            *Self,
+            &menuActive,
+            self,
+            .{ .detail = "active" },
+        );
+
+        // The sidebar's own action group, so its menu can reach a dialog the
+        // window knows nothing about. Actions resolve up the widget tree, so
+        // "sidebar.preferences" from the menu inside us lands here.
+        const actions = gio.SimpleActionGroup.new();
+        const preferences = gio.SimpleAction.new("preferences", null);
+        _ = gio.SimpleAction.signals.activate.connect(
+            preferences,
+            *Self,
+            &openPreferences,
+            self,
+            .{},
+        );
+        actions.as(gio.ActionMap).addAction(preferences.as(gio.Action));
+        preferences.unref();
+        self.as(gtk.Widget).insertActionGroup("sidebar", actions.as(gio.ActionGroup));
+        actions.unref();
+
+        self.as(gtk.Widget).setVisible(0);
+        self.applyCollapsed();
+    }
+
+    fn openPreferences(
+        _: *gio.SimpleAction,
+        _: ?*glib.Variant,
+        self: *Self,
+    ) callconv(.c) void {
+        const priv = self.private();
+        prefs.present(
+            Application.default().allocator(),
+            self.as(gtk.Widget),
+            priv.settings,
+            priv.baseline,
+            &applyFromPreferences,
+            self,
+        );
+    }
+
+    /// The dialog changed something. It has already normalized and saved; all
+    /// that is left is to look like it.
+    fn applyFromPreferences(ctx: ?*anyopaque, settings: Settings) void {
+        const self: *Self = @ptrCast(@alignCast(ctx orelse return));
+        self.setSettings(settings);
+    }
+
+    fn dispose(self: *Self) callconv(.c) void {
+        const priv = self.private();
+
+        self.cancelHoverTimer();
+        const alloc = Application.default().allocator();
+        for (priv.rows.items) |*row| row.deinit(alloc);
+        priv.rows.deinit(alloc);
+
+        // The provider was added to the display, which outlives this widget,
+        // so it has to be taken back off or a closed window keeps styling
+        // every window that is still open.
+        if (priv.css_provider) |provider| {
+            if (gdk.Display.getDefault()) |display| {
+                gtk.StyleContext.removeProviderForDisplay(
+                    display,
+                    provider.as(gtk.StyleProvider),
+                );
+            }
+            provider.unref();
+            priv.css_provider = null;
+        }
+
+        if (priv.icon_theme) |t| {
+            t.unref();
+            priv.icon_theme = null;
+        }
+
+        if (priv.config) |config| {
+            config.unref();
+            priv.config = null;
+        }
+        if (priv.tab_view) |tab_view| {
+            tab_view.unref();
+            priv.tab_view = null;
+        }
+
+        gtk.Widget.disposeTemplate(self.as(gtk.Widget), getGObjectType());
+        gobject.Object.virtual_methods.dispose.call(Class.parent, self.as(Parent));
+    }
+
+    //---------------------------------------------------------------
+    // Collapse / Expand
+
+    pub fn isCollapsed(self: *Self) bool {
+        return self.private().collapsed;
+    }
+
+    /// Collapse the sidebar back to the icon rail. Called by the window when
+    /// the user types or clicks the terminal, and when the pointer leaves.
+    ///
+    /// In `expanded` mode there is nothing to collapse to: the panel is the
+    /// resting state, and typing must not make it flinch.
+    pub fn collapse(self: *Self) void {
+        self.cancelHoverTimer();
+        if (self.private().settings.mode == .expanded) return;
+        self.setCollapsed(true);
+    }
+
+    /// The collapsed state the current mode rests in with nothing happening.
+    /// `hover` rests as the rail and only leaves it while the pointer is on
+    /// the sidebar; the other two never leave their resting state at all.
+    fn restingCollapsed(self: *Self) bool {
+        return switch (self.private().settings.mode) {
+            .hover, .rail => true,
+            .expanded => false,
+        };
+    }
+
+    /// Whether the sidebar should exist at all. Driven by the window from tab
+    /// count; going inactive slides the rail out rather than snapping it
+    /// away, which is what makes closing your second-to-last tab animate.
+    pub fn setActive(self: *Self, active: bool) void {
+        const priv = self.private();
+        if (priv.active == active) return;
+        priv.active = active;
+
+        // Must be visible before it can animate in.
+        if (active) self.as(gtk.Widget).setVisible(1);
+
+        // Either direction returns to the mode's resting state, never to
+        // wherever a half-finished hover left things. This goes through
+        // setCollapsed rather than writing the field so that
+        // notify::collapsed still fires -- otherwise a sidebar that was open
+        // when the second-to-last tab closed would leave the window's scrim
+        // switched on with nothing to dim.
+        self.cancelHoverTimer();
+        self.setCollapsed(self.restingCollapsed());
+        self.applyCollapsed();
+    }
+
+    /// The content widget we inset to make room for the rail.
+    pub fn setContentInset(self: *Self, content: *gtk.Widget, on_right: bool) void {
+        const priv = self.private();
+        priv.content = content;
+        priv.on_right = on_right;
+
+        // The hairline goes on whichever edge faces the terminal.
+        self.toggleCssClass("sidebar-right", on_right);
+
+        self.applyInset(priv.current_width);
+    }
+
+    /// The settings currently in force. The window reads `auto_hide` from
+    /// here so that "should the sidebar exist at all" answers to the same
+    /// layered value the sidebar itself uses, not to the raw config.
+    pub fn getSettings(self: *Self) *const Settings {
+        return &self.private().settings;
+    }
+
+    /// The settings `sidebar.conf` is layered on top of. Pushed in by the
+    /// window, which is the only thing here that can see the config.
+    pub fn setBaseline(self: *Self, baseline: Settings) void {
+        const priv = self.private();
+        priv.baseline = baseline;
+        priv.baseline.normalize();
+    }
+
+    /// Adopt a new set of settings and redraw to match.
+    ///
+    /// Everything here has to be re-pushed rather than read on demand: the
+    /// animation duration lives on the `AdwTimedAnimation`, the widths reach
+    /// the widget through a size request, and the mode decides whether the
+    /// collapsed flag is ours to change at all. Called on config reload and,
+    /// later, from the preferences dialog.
+    pub fn setSettings(self: *Self, settings: Settings) void {
+        const priv = self.private();
+        priv.settings = settings;
+        priv.settings.normalize();
+
+        if (priv.animation) |anim| {
+            anim.setDuration(priv.settings.animation_duration);
+        }
+
+        // Land in the new mode's resting state. A countdown left over from
+        // the mode we are leaving would otherwise fire against the new one.
+        self.cancelHoverTimer();
+        self.setCollapsed(self.restingCollapsed());
+
+        // Every icon sits in a square of the same size, the "+" included --
+        // that shared box, not the glyphs, is what keeps them in one column.
+        // Rows are sized here as well as in `rowSetup`, because the ones
+        // already realized would otherwise keep the old size until recycled.
+        const chip: c_int = @intCast(priv.settings.icon_size);
+        self.setIcon(priv.new_tab_icon, "tab-new-symbolic", chip);
+        for (priv.rows.items) |row| {
+            self.setIcon(row.icon, "utilities-terminal-symbolic", chip);
+        }
+
+        // The overview and menu buttons build their own images from an
+        // icon-name, which would come from the desktop theme. Give them ours.
+        // Sized to the glyph, not the chip. These two do not stand in the
+        // icon column -- expanded they sit together at the trailing edge, and
+        // a chip-sized box would pad them apart from each other by the
+        // difference. On the rail the button's own min-width makes the chip.
+        const glyph: c_int = @intCast(priv.settings.glyphSize());
+        self.setButtonIcon(priv.overview_button, "view-grid-symbolic", glyph);
+        self.setMenuIcon(priv.menu_button, "open-menu-symbolic", glyph);
+
+        self.updateCss();
+        self.applyCollapsed();
+
+        // `git_branch` decides whether a row holds a file monitor at all, so
+        // toggling it has to add or drop the watches, not just hide a label.
+        for (priv.rows.items) |*row| self.watchBranch(row);
+
+        // Tooltips differ between modes, so they are rebuilt rather than left
+        // describing the mode we just left.
+        self.refreshNames();
+        self.refreshContent();
+    }
+
+    /// Regenerate the sidebar's stylesheet from the current settings.
+    ///
+    /// Sizes that GTK draws rather than measures -- the corner radius, and
+    /// the margins that turn a full-width row into a centred chip -- can only
+    /// be expressed in CSS, and `style.css` is a static resource compiled
+    /// into the binary. So the configurable half of it is re-emitted here and
+    /// loaded over the top.
+    ///
+    /// Priority sits one above `STYLE_PROVIDER_PRIORITY_USER`, which is where
+    /// GTK loads `~/.config/gtk-4.0/gtk.css`.
+    ///
+    /// That is not greed. A desktop theme installed there -- MacTahoe, in the
+    /// case that found this -- is a full stylesheet with hundreds of rules on
+    /// `button`, `image` and `listview`, and at any lower priority it wins
+    /// against ours. The visible result was the "New Tab" button sitting 8px
+    /// off the axis of the tab icons, because the theme's button padding beat
+    /// the margins we compute from the configured width.
+    ///
+    /// These rules are scoped entirely to `.ghostty-tab-sidebar`, so nothing
+    /// outside the sidebar is affected. The cost is that `gtk-custom-css`
+    /// can no longer restyle the sidebar's geometry -- colours and anything
+    /// we do not set still work.
+    fn updateCss(self: *Self) void {
+        const priv = self.private();
+        const alloc = Application.default().allocator();
+
+        var buf: std.ArrayListUnmanaged(u8) = .empty;
+        defer buf.deinit(alloc);
+
+        self.writeCss(buf.writer(alloc)) catch |err| {
+            log.warn("unable to build sidebar css error={}", .{err});
+            return;
+        };
+
+        const provider = priv.css_provider orelse provider: {
+            const display = gdk.Display.getDefault() orelse {
+                log.warn("no display; sidebar css not applied", .{});
+                return;
+            };
+
+            const p = gtk.CssProvider.new();
+            gtk.StyleContext.addProviderForDisplay(
+                display,
+                p.as(gtk.StyleProvider),
+                gtk.STYLE_PROVIDER_PRIORITY_USER + 1,
+            );
+            priv.css_provider = p;
+            break :provider p;
+        };
+
+        const bytes = glib.Bytes.new(buf.items.ptr, buf.items.len);
+        defer bytes.unref();
+
+        // Replaces whatever this provider held before, so nothing accumulates
+        // across reloads.
+        provider.loadFromBytes(bytes);
+    }
+
+    fn writeCss(
+        self: *Self,
+        writer: anytype,
+    ) @TypeOf(writer).Error!void {
+        const s = &self.private().settings;
+
+        // The terminal-facing edge is the rounded one, and which edge that is
+        // depends on the side the sidebar sits on.
+        try writer.print(
+            \\.ghostty-tab-sidebar {{
+            \\  border-radius: 0 {[r]d}px {[r]d}px 0;
+            \\}}
+            \\.ghostty-tab-sidebar.sidebar-right {{
+            \\  border-radius: {[r]d}px 0 0 {[r]d}px;
+            \\}}
+            \\
+        , .{ .r = s.corner_radius });
+
+        // The chip. A collapsed row fills the rail, so its side margins are
+        // what decide the chip's width -- and the "+" needs a smaller margin
+        // to land on the same axis, because a flat button carries 6px of
+        // Adwaita padding that our `padding: 0` never wins against. The two
+        // are a derived pair; see `Settings.newButtonMargin`.
+        try writer.print(
+            \\.ghostty-tab-sidebar.collapsed listview > row {{
+            \\  margin: 2px 0;
+            \\  min-height: {[chip]d}px;
+            \\}}
+            \\.ghostty-tab-sidebar button.flat {{
+            \\  margin: 6px 0 2px;
+            \\  padding: 0;
+            \\  min-height: {[chip]d}px;
+            \\}}
+            \\
+            \\/* The chip width is a rail thing: it is what makes a lone icon
+            \\ * a square. Expanded it only pads the overview and menu buttons
+            \\ * apart from each other and from the panel edge. */
+            \\.ghostty-tab-sidebar.collapsed button.flat {{
+            \\  min-width: {[chip]d}px;
+            \\}}
+
+            \\
+        , .{ .chip = s.icon_size });
+
+        // Size the glyphs themselves, not just the boxes around them.
+        //
+        // The row and "+" images are ours and get `set_pixel_size`, but the
+        // overview and menu buttons build their images from an icon-name, so
+        // there is no widget to call it on. Left alone they render at the
+        // theme's natural 16px, which in rail mode -- where the menu button
+        // is pinned visible -- makes that button wider than the rail and puts
+        // it on a different axis from the tab icons below it.
+        try writer.print(
+            \\.ghostty-tab-sidebar .ghostty-sidebar-top-bar image,
+            \\.ghostty-tab-sidebar .ghostty-tab-icon {{
+            \\  -gtk-icon-size: {[glyph]d}px;
+            \\}}
+            \\
+        , .{ .glyph = s.glyphSize() });
+
+        // The hairline along the terminal-facing edge. Dropping it means
+        // restating every box-shadow rule rather than unsetting one, because
+        // the expanded state packs the hairline and the drop shadow into a
+        // single property.
+        if (!s.border) {
+            try writer.writeAll(
+                \\.ghostty-tab-sidebar,
+                \\.ghostty-tab-sidebar.sidebar-right {
+                \\  box-shadow: none;
+                \\}
+                \\.ghostty-tab-sidebar:not(.collapsed),
+                \\.ghostty-tab-sidebar.sidebar-right:not(.collapsed) {
+                \\  box-shadow: 0 0 12px 0 var(--sidebar-shade-color);
+                \\}
+                \\
+            );
+        }
+    }
+
+    fn setCollapsed(self: *Self, collapsed: bool) void {
+        const priv = self.private();
+        if (priv.collapsed == collapsed) return;
+        priv.collapsed = collapsed;
+        self.applyCollapsed();
+
+        self.as(gobject.Object).notifyByPspec(
+            properties.collapsed.impl.param_spec,
+        );
+    }
+
+    fn targetWidth(self: *Self) f64 {
+        const priv = self.private();
+        if (!priv.active) return 0;
+        return @floatFromInt(if (priv.collapsed)
+            priv.settings.width
+        else
+            priv.settings.expanded_width);
+    }
+
+    fn applyCollapsed(self: *Self) void {
+        const priv = self.private();
+        const collapsed = priv.collapsed;
+
+        // Expanding maps the content before the slide starts, so the rows are
+        // already their final size and the panel merely uncovers them.
+        // Collapsing leaves it mapped; `animationDone` hides it once the
+        // panel has actually closed.
+        if (!collapsed) priv.content_shown = true;
+        self.applyContentVisibility();
+
+        self.animateWidth(self.targetWidth());
+        self.toggleCssClass("collapsed", collapsed);
+
+        priv.new_tab_button.as(gtk.Widget).setVisible(
+            @intFromBool(priv.settings.new_button),
+        );
+
+        self.applyRailInsets();
+    }
+
+
+    /// Fade every label and close button to match the current width, and map
+    /// them according to whether the sidebar is *meant* to be open.
+    ///
+    /// Opacity follows the animated width so the text fades with the slide.
+    /// Visibility must not: it decides how much horizontal space the row asks
+    /// for, and the animated width is not a reliable statement of how wide
+    /// the rail actually is. Whenever the two disagreed -- an animation that
+    /// never received a frame, a transition retargeted mid-slide -- the rows
+    /// were laid out for the expanded panel while the rail was allocated at
+    /// 46px, so a 217px row got clipped to an empty stripe with its icon
+    /// pushed out of sight. Keying visibility off `collapsed` makes that
+    /// disagreement impossible: the row asks for exactly the state we are in.
+    /// Show or hide everything that only exists in the expanded panel.
+    ///
+    /// No fade, and no reveal: the row is built at its final size and the
+    /// panel slides to uncover it. There used to be an opacity ramp keyed to
+    /// the animated width, which made the close button and the labels arrive
+    /// in the last third of the slide -- read as the tab "growing" just as the
+    /// panel finished.
+    ///
+    /// The direction matters. Expanding shows the content immediately, so the
+    /// row is full height before the first frame. Collapsing leaves it alone
+    /// and hides it in `animationDone`: hiding it up front drops each row from
+    /// two text lines to one icon while the panel is still wide, which is the
+    /// vertical squeeze the icons appeared to do on the way in.
+    fn applyContentVisibility(self: *Self) void {
+        const priv = self.private();
+
+        const shown = priv.content_shown;
+        const vis: c_int = @intFromBool(shown);
+
+        for (priv.rows.items) |*row| {
+            row.text_box.as(gtk.Widget).setVisible(vis);
+            row.close.as(gtk.Widget).setVisible(vis);
+            self.applyIndicatorVisibility(row);
+        }
+
+        priv.new_tab_label.as(gtk.Widget).setVisible(vis);
+        priv.overview_button.as(gtk.Widget).setVisible(vis);
+
+        // Except in `rail` mode, where the sidebar never widens and hiding
+        // the menu would strand the user: the preferences that could put the
+        // sidebar back are behind that button, and there is no other way to
+        // reach them short of editing a file by hand. So it stays, and the
+        // top bar turns vertical to give it a row of its own -- side by side,
+        // two chips do not fit in the rail and the second would be clipped.
+        const pinned = priv.settings.mode == .rail;
+        priv.menu_button.as(gtk.Widget).setVisible(if (pinned) 1 else vis);
+
+        priv.top_bar.as(gtk.Orientable).setOrientation(
+            if (pinned) .vertical else .horizontal,
+        );
+
+        self.applyRailInsets();
+    }
+
+    /// Push `width` into the size request, the terminal's inset and the label
+    /// fade. This is the single place the width becomes visible; the
+    /// animation, and every path that bypasses it, all land here.
+    fn applyWidth(self: *Self, width: f64) void {
+        const priv = self.private();
+        priv.current_width = width;
+
+        // setSizeRequest only raises the *minimum*. That is enough because
+        // the content sits in a ScrolledWindow with propagate-natural-width
+        // off, whose natural width is therefore 0 -- so the request is what
+        // decides both, and the rail follows it exactly.
+        self.as(gtk.Widget).setSizeRequest(@intFromFloat(width), -1);
+
+        self.applyInset(width);
+    }
+
+    /// Animate the sidebar width to `target`, starting from wherever the
+    /// current animation left off so that a reversal mid-slide is smooth
+    /// rather than jumping.
+    fn animateWidth(self: *Self, target: f64) void {
+        const priv = self.private();
+
+        const anim = priv.animation orelse {
+            self.applyWidth(target);
+            return;
+        };
+
+        // Deliberately no `skip()` here.
+        //
+        // adw_animation_skip() jumps the animation to its *current* value_to
+        // -- the target we are leaving -- and then, because it leaves the
+        // animation FINISHED, a later skip() is a no-op. Calling it before
+        // re-targeting therefore snapped the width to the wrong end of the
+        // slide, and if the new animation then failed to receive a frame the
+        // width stayed there. Measured: after a few hover cycles every
+        // expand left current_width at the rail's 46 and every collapse left
+        // it at the panel's 260 -- exactly inverted -- which is what
+        // rendered an "open" sidebar as a clipped 46px stripe.
+        //
+        // adw_animation_play() already restarts a playing or finished
+        // animation from value_from, so nothing needs skipping first.
+        anim.setValueFrom(priv.current_width);
+        anim.setValueTo(target);
+        anim.as(adw.Animation).play();
+    }
+
+    /// The animation has settled: adopt its end value.
+    ///
+    /// `done` also fires when an animation is skipped rather than played out,
+    /// in which case the per-frame callback never walked the width to the
+    /// target. Re-applying it here means the resting state is always the one
+    /// the collapsed flag asks for, however the slide got there.
+    fn animationDone(anim: *adw.Animation, self: *Self) callconv(.c) void {
+        const priv = self.private();
+        self.applyWidth(anim.getValue());
+
+        // The panel has finished closing, so the rows can drop to one line
+        // now without that change being visible as a squeeze mid-slide.
+        if (priv.collapsed and priv.content_shown) {
+            priv.content_shown = false;
+            self.applyContentVisibility();
+        }
+
+        // Hide on `done` rather than trusting the width to reach zero.
+        if (!priv.active) self.as(gtk.Widget).setVisible(0);
+    }
+
+    fn animationValue(value: f64, ud: ?*anyopaque) callconv(.c) void {
+        const self: *Self = @ptrCast(@alignCast(ud orelse return));
+        const priv = self.private();
+
+        self.applyWidth(value);
+
+        // The rail's natural width would keep it on screen at the end of the
+        // slide-out. Hide it once the animation has actually reached zero.
+        if (!priv.active and value < 1) self.as(gtk.Widget).setVisible(0);
+    }
+
+    /// Inset the content by the *rail* width, never more. Expanding past the
+    /// rail overlays the terminal instead of pushing it, so the margin stays
+    /// put; sliding the rail out to zero takes the margin with it, so the
+    /// terminal reclaims the space in step with the animation.
+    fn applyInset(self: *Self, width: f64) void {
+        const priv = self.private();
+        const content = priv.content orelse return;
+
+        const rail: f64 = @floatFromInt(priv.settings.width);
+
+        // How much of the sidebar the terminal has to make room for.
+        //
+        // `hover` and `rail` reserve the rail and no more, so an expansion
+        // floats over the terminal instead of reflowing it -- that overlay is
+        // the whole point of the hover design. `expanded` has no expansion to
+        // overlay *with*: the panel is simply always there, and a permanent
+        // widget sitting on top of the terminal would just be hiding the
+        // first 200-odd columns of every line.
+        const reserve_to: f64 = switch (priv.settings.mode) {
+            .hover, .rail => rail,
+            .expanded => @floatFromInt(priv.settings.expanded_width),
+        };
+        const reserved = @min(width, reserve_to);
+
+        // The gap fades in with the rail rather than being added flat, so
+        // sliding out to nothing does not leave an 8px ledge behind at the
+        // last frame. A configured width of zero would make that fraction a
+        // NaN, so it is spelled out rather than divided.
+        const inset: c_int = @intFromFloat(
+            reserved + if (rail > 0) (reserved / rail) * content_gap else 0,
+        );
+
+        // Expanding past the rail never changes the inset, so most frames of
+        // a slide have nothing to do here. Skipping them keeps the terminal
+        // from being relaid out on every frame.
+        if (inset == priv.last_inset) return;
+        priv.last_inset = inset;
+
+        content.setMarginStart(if (priv.on_right) 0 else inset);
+        content.setMarginEnd(if (priv.on_right) inset else 0);
+    }
+
+    fn toggleCssClass(self: *Self, name: [*:0]const u8, present: bool) void {
+        const widget = self.as(gtk.Widget);
+        if (present) {
+            widget.addCssClass(name);
+        } else {
+            widget.removeCssClass(name);
+        }
+    }
+
+    fn cancelHoverTimer(self: *Self) void {
+        const priv = self.private();
+        if (priv.hover_timer) |id| {
+            if (glib.Source.remove(id) == 0) {
+                log.warn("failed to remove hover timer id={}", .{id});
+            }
+            priv.hover_timer = null;
+        }
+    }
+
+    fn hoverEnter(
+        _: *gtk.EventControllerMotion,
+        _: f64,
+        _: f64,
+        self: *Self,
+    ) callconv(.c) void {
+        const priv = self.private();
+
+        // Only `hover` mode reacts to the pointer at all. The other two pin
+        // the sidebar open or shut, and a stray motion event must not undo
+        // that.
+        if (priv.settings.mode != .hover) return;
+
+        // Expanding is instant: any pending collapse is abandoned.
+        self.cancelHoverTimer();
+        if (priv.active) self.setCollapsed(false);
+    }
+
+    fn hoverLeave(_: *gtk.EventControllerMotion, self: *Self) callconv(.c) void {
+        self.armCollapse();
+    }
+
+    /// Start the collapse countdown, unless the menu is open. Opening the
+    /// menu moves the pointer onto its popover, which reads as leaving the
+    /// sidebar -- collapsing it out from under the menu you just opened.
+    fn armCollapse(self: *Self) void {
+        const priv = self.private();
+        if (priv.settings.mode != .hover) return;
+        if (priv.collapsed) return;
+        if (priv.menu_button.getActive() != 0) return;
+
+        self.cancelHoverTimer();
+        priv.hover_timer = glib.timeoutAdd(
+            priv.settings.collapse_delay,
+            hoverTimer,
+            self,
+        );
+    }
+
+    fn menuActive(
+        menu: *gtk.MenuButton,
+        _: *gobject.ParamSpec,
+        self: *Self,
+    ) callconv(.c) void {
+        if (menu.getActive() != 0) {
+            // Menu opening: hold the sidebar open for as long as it is up.
+            self.cancelHoverTimer();
+            return;
+        }
+
+        // Menu dismissed: resume the normal countdown.
+        self.armCollapse();
+    }
+
+    fn hoverTimer(ud: ?*anyopaque) callconv(.c) c_int {
+        const self: *Self = @ptrCast(@alignCast(ud orelse return 0));
+        self.private().hover_timer = null;
+        self.setCollapsed(true);
+        return 0;
+    }
+
+    //---------------------------------------------------------------
+    // Properties
+
+    fn propTabView(self: *Self, _: *gobject.ParamSpec, _: ?*anyopaque) callconv(.c) void {
+        const priv = self.private();
+
+        const tab_view = priv.tab_view orelse {
+            priv.list_view.setModel(null);
+            return;
+        };
+
+        // The pages model is already a GtkSelectionModel maintained by
+        // AdwTabView, so handing it over is all the wiring selection needs.
+        // We own a reference from getPages and the list view takes its own.
+        const model = tab_view.getPages();
+        defer model.unref();
+        priv.list_view.setModel(model);
+    }
+
+    //---------------------------------------------------------------
+    // Naming
+    //
+    // A tab is labelled with just its folder name. When two tabs would show
+    // the same name we prepend parent directories to each, one level at a
+    // time, until they differ -- the way editors disambiguate same-named
+    // files. When the paths are genuinely identical (two shells in one
+    // directory) no amount of path helps, so we fall back to the terminal
+    // title, which with shell integration is usually the running command.
+
+    fn pageSurface(page: *adw.TabPage) ?*Surface {
+        const tab = gobject.ext.cast(Tab, page.getChild()) orelse return null;
+        return tab.getActiveSurface();
+    }
+
+    fn pagePwd(page: *adw.TabPage) ?[:0]const u8 {
+        const surface = pageSurface(page) orelse return null;
+        return surface.getPwd();
+    }
+
+    fn pageTitle(page: *adw.TabPage) ?[:0]const u8 {
+        const surface = pageSurface(page) orelse return null;
+        return surface.getTitle();
+    }
+
+    /// The trailing `n` path components of `path`.
+    fn tailComponents(path: []const u8, n: usize) []const u8 {
+        var end = path.len;
+        while (end > 1 and path[end - 1] == '/') end -= 1;
+        if (end == 0) return path;
+
+        var seen: usize = 0;
+        var i = end;
+        while (i > 0) {
+            i -= 1;
+            if (path[i] == '/') {
+                seen += 1;
+                if (seen == n) return path[i + 1 .. end];
+            }
+        }
+        return path[0..end];
+    }
+
+    fn trimmedLen(path: []const u8) usize {
+        var end = path.len;
+        while (end > 1 and path[end - 1] == '/') end -= 1;
+        return end;
+    }
+
+    fn canGrow(path: []const u8, n: usize) bool {
+        return tailComponents(path, n).len < trimmedLen(path);
+    }
+
+    /// Recompute every realized row's label and tooltip.
+    fn refreshNames(self: *Self) void {
+        const priv = self.private();
+        const tab_view = priv.tab_view orelse return;
+        if (priv.rows.items.len == 0) return;
+
+        const n = tab_view.getNPages();
+        if (n <= 0) return;
+        const count: usize = @intCast(n);
+
+        const alloc = Application.default().allocator();
+        const paths = alloc.alloc(?[:0]const u8, count) catch return;
+        defer alloc.free(paths);
+        const depths = alloc.alloc(usize, count) catch return;
+        defer alloc.free(depths);
+
+        for (0..count) |i| {
+            paths[i] = pagePwd(tab_view.getNthPage(@intCast(i)));
+            depths[i] = 1;
+        }
+
+        // Grow colliding names until they differ or we run out of path.
+        var round: usize = 0;
+        while (round < max_name_depth) : (round += 1) {
+            var changed = false;
+            for (0..count) |i| {
+                const pi = paths[i] orelse continue;
+                for (i + 1..count) |j| {
+                    const pj = paths[j] orelse continue;
+                    // Identical paths can never be told apart by path.
+                    if (std.mem.eql(u8, pi, pj)) continue;
+                    if (!std.mem.eql(
+                        u8,
+                        tailComponents(pi, depths[i]),
+                        tailComponents(pj, depths[j]),
+                    )) continue;
+
+                    if (canGrow(pi, depths[i])) {
+                        depths[i] += 1;
+                        changed = true;
+                    }
+                    if (canGrow(pj, depths[j])) {
+                        depths[j] += 1;
+                        changed = true;
+                    }
+                }
+            }
+            if (!changed) break;
+        }
+
+        for (priv.rows.items) |row| {
+            const idx = pageIndex(tab_view, row.page) orelse continue;
+            const path = paths[idx];
+
+            // Does another tab share this exact path? Then disambiguate with
+            // the terminal title instead.
+            var duplicate_path = false;
+            if (path) |p| {
+                for (0..count) |k| {
+                    if (k == idx) continue;
+                    const other = paths[k] orelse continue;
+                    if (std.mem.eql(u8, p, other)) {
+                        duplicate_path = true;
+                        break;
+                    }
+                }
+            }
+
+            self.applyRowName(row, path, depths[idx], duplicate_path);
+        }
+    }
+
+    fn applyRowName(
+        self: *Self,
+        row: Row,
+        path: ?[:0]const u8,
+        depth: usize,
+        duplicate_path: bool,
+    ) void {
+        const alloc = Application.default().allocator();
+
+        const p = path orelse {
+            // No working directory known; fall back to the page title.
+            const t = row.page.getTitle();
+            row.label.setText(t);
+            row.box.as(gtk.Widget).setTooltipText(t);
+            return;
+        };
+
+        const short = tailComponents(p, depth);
+
+        // Two tabs in one directory are told apart by their titles. Unless
+        // the subtitle line is already showing that title, in which case
+        // appending it here would print it twice on one row.
+        const disambiguate = duplicate_path and
+            self.private().settings.subtitle != .title;
+
+        const label_text: [:0]const u8 = if (disambiguate) blk: {
+            const title = pageTitle(row.page) orelse
+                break :blk alloc.dupeZ(u8, short) catch return;
+            break :blk std.fmt.allocPrintSentinel(
+                alloc,
+                "{s} — {s}",
+                .{ short, title },
+                0,
+            ) catch return;
+        } else alloc.dupeZ(u8, short) catch return;
+        defer alloc.free(label_text);
+
+        row.label.setText(label_text);
+
+        // The tooltip always carries the full path, so a grown or truncated
+        // name never hides where the tab actually is.
+        //
+        // In `rail` mode it carries the name as well, because that is the one
+        // mode where the row never shows its label: the sidebar does not
+        // expand, so the tooltip is the only place the name can appear. The
+        // other modes leave it out -- there the label is either on screen
+        // already or one hover away, and repeating it would just be noise.
+        //
+        // (In `hover` mode row tooltips are close to unreachable anyway:
+        // pointing at a row expands the sidebar immediately, which is a
+        // pointer-crossing event, and GTK restarts the tooltip timeout.)
+        if (self.private().settings.mode != .rail) {
+            row.box.as(gtk.Widget).setTooltipText(p);
+            return;
+        }
+
+        // The rail tooltip stands in for the whole expanded row, branch
+        // included -- it is the only way any of it can be read in this mode.
+        const tip = if (row.branch) |b|
+            std.fmt.allocPrintSentinel(alloc, "{s}\n⎇ {s}\n{s}", .{ label_text, b, p }, 0)
+        else
+            std.fmt.allocPrintSentinel(alloc, "{s}\n{s}", .{ label_text, p }, 0);
+
+        const text = tip catch {
+            row.box.as(gtk.Widget).setTooltipText(p);
+            return;
+        };
+        defer alloc.free(text);
+        row.box.as(gtk.Widget).setTooltipText(text);
+    }
+
+    //---------------------------------------------------------------
+    // Row content: branch, subtitle, indicators
+
+    /// Point a row at the `HEAD` governing its working directory and start
+    /// watching it, replacing whatever it was watching before.
+    ///
+    /// Called on bind and again whenever the tab's directory changes, because
+    /// a `cd` can move a tab between repositories -- or out of one entirely.
+    fn watchBranch(self: *Self, row: *Row) void {
+        const alloc = Application.default().allocator();
+
+        // Tear down the old watch first: the row may have just left the
+        // repository it was in, in which case there is nothing to set up.
+        if (row.head_monitor) |m| {
+            if (row.head_handler != 0) {
+                gobject.signalHandlerDisconnect(m.as(gobject.Object), row.head_handler);
+                row.head_handler = 0;
+            }
+            _ = m.cancel();
+            m.unref();
+            row.head_monitor = null;
+        }
+        if (row.head_path) |p| {
+            alloc.free(p);
+            row.head_path = null;
+        }
+        if (row.branch) |b| {
+            alloc.free(b);
+            row.branch = null;
+        }
+
+        if (!self.private().settings.git_branch) return;
+
+        const pwd = pagePwd(row.page) orelse return;
+        const head = git.headPath(alloc, pwd) orelse return;
+        row.head_path = head;
+        row.branch = git.readBranch(alloc, head);
+
+        // Watch the file, not the directory: `HEAD` is what a checkout
+        // rewrites, and a repository's `.git` is otherwise busy enough that
+        // watching it would wake us for every loose object.
+        const file = gio.File.newForPath(head);
+        defer file.unref();
+
+        var err: ?*glib.Error = null;
+        const monitor = file.monitorFile(.{}, null, &err) orelse {
+            defer if (err) |e| e.free();
+            log.debug("unable to watch {s}", .{head});
+            return;
+        };
+        row.head_monitor = monitor;
+        row.head_handler = gio.FileMonitor.signals.changed.connect(
+            monitor,
+            *Self,
+            &headChanged,
+            self,
+            .{},
+        );
+    }
+
+    fn headChanged(
+        monitor: *gio.FileMonitor,
+        _: *gio.File,
+        _: ?*gio.File,
+        _: gio.FileMonitorEvent,
+        self: *Self,
+    ) callconv(.c) void {
+        const priv = self.private();
+        const alloc = Application.default().allocator();
+
+        for (priv.rows.items) |*row| {
+            if (row.head_monitor != monitor) continue;
+            const head = row.head_path orelse continue;
+
+            if (row.branch) |b| alloc.free(b);
+            row.branch = git.readBranch(alloc, head);
+            self.applyRowContent(row);
+
+            // In rail mode the branch lives in the tooltip, which names
+            // rather than content owns -- so a checkout has to go through
+            // there too. Rare enough (a checkout, not a keystroke) that the
+            // full recompute costs nothing worth avoiding.
+            if (priv.settings.mode == .rail) self.refreshNames();
+            break;
+        }
+    }
+
+    /// Fill in the second line and the indicators for one row.
+    fn applyRowContent(self: *Self, row: *Row) void {
+        const s = &self.private().settings;
+
+        // Branch.
+        const show_branch = s.git_branch and row.branch != null;
+        if (row.branch) |b| {
+            const alloc = Application.default().allocator();
+            const text = std.fmt.allocPrintSentinel(alloc, "⎇ {s}", .{b}, 0) catch null;
+            if (text) |t| {
+                defer alloc.free(t);
+                row.branch_label.setText(t);
+            }
+        }
+        row.branch_label.as(gtk.Widget).setVisible(@intFromBool(show_branch));
+
+        // Subtitle.
+        const subtitle: ?[:0]const u8 = switch (s.subtitle) {
+            .none => null,
+            .title => pageTitle(row.page),
+            .path => pagePwd(row.page),
+        };
+        if (subtitle) |t| row.subtitle_label.setText(t);
+        const show_subtitle = subtitle != null and subtitle.?.len > 0;
+        row.subtitle_label.as(gtk.Widget).setVisible(@intFromBool(show_subtitle));
+
+        // The line as a whole disappears when neither half has anything, so
+        // an unconfigured row is a single line of exactly its old height.
+        row.subtitle_box.as(gtk.Widget).setVisible(
+            @intFromBool(show_branch or show_subtitle),
+        );
+
+        // Indicators.
+        const surface = row.surface;
+        const bell = s.indicators and surface != null and surface.?.getBellRinging();
+        const readonly = s.indicators and surface != null and surface.?.getReadonly();
+        row.bell_icon.as(gtk.Widget).setVisible(@intFromBool(bell));
+        row.readonly_icon.as(gtk.Widget).setVisible(@intFromBool(readonly));
+        row.wants_indicators = bell or readonly;
+        self.applyIndicatorVisibility(row);
+
+        // The indicator icons ride in the row's text area, which is hidden on
+        // the rail -- and the rail is exactly where an unattended tab ringing
+        // its bell most needs to say so. So the state also goes on the row as
+        // a CSS class, which tints the tab icon itself and survives the
+        // collapse.
+        const widget = row.box.as(gtk.Widget);
+        if (bell) {
+            widget.addCssClass("ghostty-tab-attention");
+        } else {
+            widget.removeCssClass("ghostty-tab-attention");
+        }
+    }
+
+    /// The icon theme the rail draws from.
+    ///
+    /// Not the desktop's. A rail is a column of glyphs that have to read as
+    /// one set, and icon themes disagree wildly about what these names look
+    /// like: MacTahoe draws `tab-new-symbolic` as a bare cross spanning most
+    /// of its box, next to a `utilities-terminal-symbolic` that is a small
+    /// boxed glyph, so the "+" towered over the tabs. Adwaita draws both as
+    /// boxed shapes of the same weight, which is the design this was built
+    /// against.
+    ///
+    /// So the sidebar pins its own theme and stops being at the mercy of
+    /// whichever one the desktop happens to use. `gtk-tabs-sidebar-theme-icons`
+    /// hands it back for anyone who would rather match their desktop.
+    ///
+    /// One instance, cached: constructing a GtkIconTheme rescans directories.
+    fn iconTheme(self: *Self) ?*gtk.IconTheme {
+        const priv = self.private();
+        if (priv.icon_theme) |t| return t;
+
+        const display = gdk.Display.getDefault() orelse return null;
+
+        // Start from the display's theme so the search path is right, then
+        // override only which theme is picked out of it.
+        const shared = gtk.IconTheme.getForDisplay(display);
+        const theme = gtk.IconTheme.new();
+        theme.setSearchPath(shared.getSearchPath());
+        theme.setThemeName(icon_theme_name);
+
+        priv.icon_theme = theme;
+        return theme;
+    }
+
+    /// Adwaita ships with GTK itself, so this is always present.
+    const icon_theme_name = "Adwaita";
+
+    /// Point an image at `name`, drawn at `size`.
+    fn setIcon(self: *Self, image: *gtk.Image, name: [*:0]const u8, size: c_int) void {
+        if (!self.private().settings.theme_icons) {
+            if (self.iconTheme()) |theme| {
+                const paintable = theme.lookupIcon(
+                    name,
+                    null,
+                    @intCast(self.private().settings.glyphSize()),
+                    1,
+                    .none,
+                    .{ .force_symbolic = true },
+                );
+                defer paintable.unref();
+                image.setFromPaintable(paintable.as(gdk.Paintable));
+                self.sizeIcon(image, size);
+                return;
+            }
+        }
+
+        image.setFromIconName(name);
+        self.sizeIcon(image, size);
+    }
+
+    fn setButtonIcon(self: *Self, button: *gtk.Button, name: [*:0]const u8, size: c_int) void {
+        const image = gtk.Image.new();
+        self.setIcon(image, name, size);
+        button.setChild(image.as(gtk.Widget));
+        self.private().overview_icon = image;
+    }
+
+    fn setMenuIcon(self: *Self, button: *gtk.MenuButton, name: [*:0]const u8, size: c_int) void {
+        const image = gtk.Image.new();
+        self.setIcon(image, name, size);
+        button.setChild(image.as(gtk.Widget));
+        self.private().menu_icon = image;
+    }
+
+    /// Draw an icon at exactly `size` pixels square.
+    ///
+    /// Both calls are needed and they do different jobs. `setSizeRequest` only
+    /// raises the widget's *minimum*, so on its own a symbolic icon keeps
+    /// rendering at its natural 16px: ask for an 8px chip and you get a 16px
+    /// glyph in it, the row measures wider than the rail, and GtkViewport
+    /// centres the overflow -- which is the whole column sliding off its axis,
+    /// with the "+" and the tab icons landing on different ones.
+    /// `setPixelSize` is what actually resizes the glyph.
+    fn sizeIcon(self: *Self, icon: *gtk.Image, chip: c_int) void {
+        // The chip is the box; the glyph is smaller and sits inside it. Only
+        // the box gets the configured size.
+        icon.setPixelSize(@intCast(self.private().settings.glyphSize()));
+        icon.as(gtk.Widget).setSizeRequest(chip, chip);
+    }
+
+
+    /// Apply that inset to everything in the rail that shares the icon column.
+    ///
+    /// The tab rows and the "New Tab" button always take it, because their
+    /// icons are the column and it must not move when the panel opens. The
+    /// overview and menu buttons only take it collapsed -- expanded they sit
+    /// together at the panel's trailing edge, and an inset there would space
+    /// them apart and leave the "+" ending well short of the edge.
+    fn applyRailInsets(self: *Self) void {
+        const priv = self.private();
+        const chip: c_int = @intCast(priv.settings.iconMargin());
+        const trailing: c_int = if (priv.collapsed) chip else 0;
+
+        for (priv.rows.items) |row| {
+            // The chip background is drawn on the list item, which is the
+            // parent of the box we built -- inset that, not our box, or the
+            // highlight stays full width while its contents move.
+            const item = row.box.as(gtk.Widget).getParent() orelse continue;
+            item.setMarginStart(chip);
+            item.setMarginEnd(chip);
+        }
+
+        // Expanded, the button keeps its leading inset so the "+" stays in
+        // the column, and gives up its trailing one so it runs to the buttons.
+        const new_tab = priv.new_tab_button.as(gtk.Widget);
+        new_tab.setMarginStart(chip);
+        new_tab.setMarginEnd(trailing);
+
+        for ([_]*gtk.Widget{
+            priv.overview_button.as(gtk.Widget),
+            priv.menu_button.as(gtk.Widget),
+        }) |w| {
+            w.setMarginStart(trailing);
+            w.setMarginEnd(trailing);
+        }
+
+        // Collapsed, these have to sit in the icon column like everything
+        // else -- which in `rail` mode the menu button really does, pinned
+        // under the "+". Expanded they pair up at the trailing edge, where a
+        // chip-sized box would only hold them apart.
+        const box: c_int = if (priv.collapsed)
+            chip
+        else
+            @intCast(priv.settings.glyphSize());
+        for ([_]?*gtk.Image{ priv.overview_icon, priv.menu_icon }) |maybe| {
+            const image = maybe orelse continue;
+            image.as(gtk.Widget).setSizeRequest(box, box);
+        }
+    }
+
+    /// Indicators are only ever shown expanded; see `Row.wants_indicators`.
+    fn applyIndicatorVisibility(self: *Self, row: *const Row) void {
+        row.indicator_box.as(gtk.Widget).setVisible(
+            @intFromBool(row.wants_indicators and !self.private().collapsed),
+        );
+    }
+
+    /// Re-fill every realized row.
+    fn refreshContent(self: *Self) void {
+        for (self.private().rows.items) |*row| self.applyRowContent(row);
+    }
+
+    fn pageIndex(tab_view: *adw.TabView, page: *adw.TabPage) ?usize {
+        const n = tab_view.getNPages();
+        var i: c_int = 0;
+        while (i < n) : (i += 1) {
+            if (tab_view.getNthPage(i) == page) return @intCast(i);
+        }
+        return null;
+    }
+
+    //---------------------------------------------------------------
+    // Row Factory
+
+    fn rowSetup(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+
+        // No margins on the row box at all. The chip's own margins centre it
+        // in the rail; anything here would be added on top of that and push
+        // the content wider than the rail.
+        const box = gtk.Box.new(.horizontal, 6);
+
+        const icon = gtk.Image.new();
+        self.setIcon(icon, "utilities-terminal-symbolic", @intCast(self.private().settings.icon_size));
+        // Named so the bell can tint this icon and nothing else in the row --
+        // not the indicators, not the close button's glyph.
+        icon.as(gtk.Widget).addCssClass("ghostty-tab-icon");
+        box.append(icon.as(gtk.Widget));
+
+        // The title sits in a vertical box with a second line beneath it for
+        // the branch and the subtitle. The second line is built whether or
+        // not it is wanted, and hidden when it has nothing to show -- so
+        // turning the setting on costs a visibility change rather than a
+        // rebuild of every realized row.
+        const text_box = gtk.Box.new(.vertical, 0);
+        text_box.as(gtk.Widget).setHexpand(1);
+        const title = gtk.Label.new(null);
+        title.setXalign(0);
+        title.setEllipsize(.end);
+        title.setSingleLineMode(1);
+        text_box.append(title.as(gtk.Widget));
+
+        const subtitle_box = gtk.Box.new(.horizontal, 6);
+        const branch_label = gtk.Label.new(null);
+        branch_label.setXalign(0);
+        branch_label.setEllipsize(.end);
+        branch_label.setSingleLineMode(1);
+        branch_label.as(gtk.Widget).addCssClass("ghostty-tab-branch");
+        subtitle_box.append(branch_label.as(gtk.Widget));
+
+        const subtitle_label = gtk.Label.new(null);
+        subtitle_label.setXalign(0);
+        subtitle_label.setEllipsize(.end);
+        subtitle_label.setSingleLineMode(1);
+        subtitle_label.as(gtk.Widget).setHexpand(1);
+        subtitle_label.as(gtk.Widget).addCssClass("ghostty-tab-subtitle");
+        subtitle_box.append(subtitle_label.as(gtk.Widget));
+
+        text_box.append(subtitle_box.as(gtk.Widget));
+        box.append(text_box.as(gtk.Widget));
+
+        // Status icons. Individually shown, so a ringing bell does not also
+        // reserve room for a padlock that is not there.
+        const indicator_box = gtk.Box.new(.horizontal, 2);
+        const bell_icon = gtk.Image.newFromIconName("bell-outline-symbolic");
+        bell_icon.as(gtk.Widget).setTooltipText("Bell");
+        indicator_box.append(bell_icon.as(gtk.Widget));
+        const readonly_icon = gtk.Image.newFromIconName("changes-prevent-symbolic");
+        readonly_icon.as(gtk.Widget).setTooltipText("Read-only");
+        indicator_box.append(readonly_icon.as(gtk.Widget));
+        box.append(indicator_box.as(gtk.Widget));
+
+        const close = gtk.Button.newFromIconName("window-close-symbolic");
+        close.as(gtk.Widget).addCssClass("flat");
+        close.as(gtk.Widget).addCssClass("circular");
+        close.as(gtk.Widget).setFocusOnClick(0);
+        _ = gtk.Button.signals.clicked.connect(close, *Self, &rowCloseClicked, self, .{});
+        box.append(close.as(gtk.Widget));
+
+        // Middle click closes the tab, as it does in a browser tab strip.
+        // This works in rail mode too, where the close button is hidden.
+        const middle = gtk.GestureClick.new();
+        middle.as(gtk.GestureSingle).setButton(gdk.BUTTON_MIDDLE);
+        _ = gtk.GestureClick.signals.pressed.connect(
+            middle,
+            *Self,
+            &rowMiddleClick,
+            self,
+            .{},
+        );
+        box.as(gtk.Widget).addController(middle.as(gtk.EventController));
+
+        const obj = list_item.as(gobject.Object);
+        gobject.Object.setData(obj, key_row_box, box);
+        gobject.Object.setData(obj, key_title_label, title);
+        gobject.Object.setData(obj, key_text_box, text_box);
+        gobject.Object.setData(obj, key_icon_image, icon);
+        gobject.Object.setData(obj, key_close_button, close);
+        gobject.Object.setData(obj, key_subtitle_box, subtitle_box);
+        gobject.Object.setData(obj, key_branch_label, branch_label);
+        gobject.Object.setData(obj, key_subtitle_label, subtitle_label);
+        gobject.Object.setData(obj, key_indicator_box, indicator_box);
+        gobject.Object.setData(obj, key_bell_icon, bell_icon);
+        gobject.Object.setData(obj, key_readonly_icon, readonly_icon);
+
+        list_item.setChild(box.as(gtk.Widget));
+    }
+
+    fn rowBind(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+        const obj = list_item.as(gobject.Object);
+
+        const item = list_item.getItem() orelse return;
+        const page = gobject.ext.cast(adw.TabPage, item) orelse return;
+
+        const box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_row_box) orelse return,
+        ));
+        const label: *gtk.Label = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_title_label) orelse return,
+        ));
+        const text_box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_text_box) orelse return,
+        ));
+        const icon: *gtk.Image = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_icon_image) orelse return,
+        ));
+        const close: *gtk.Button = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_close_button) orelse return,
+        ));
+        const subtitle_box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_subtitle_box) orelse return,
+        ));
+        const branch_label: *gtk.Label = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_branch_label) orelse return,
+        ));
+        const subtitle_label: *gtk.Label = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_subtitle_label) orelse return,
+        ));
+        const indicator_box: *gtk.Box = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_indicator_box) orelse return,
+        ));
+        const bell_icon: *gtk.Image = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_bell_icon) orelse return,
+        ));
+        const readonly_icon: *gtk.Image = @ptrCast(@alignCast(
+            gobject.Object.getData(obj, key_readonly_icon) orelse return,
+        ));
+
+        gobject.Object.setData(close.as(gobject.Object), key_page, page);
+        gobject.Object.setData(box.as(gobject.Object), key_page, page);
+
+        // Watch this tab's surface. `pwd` moves the label and the branch,
+        // `title` the subtitle, and the last two the indicators. All four go
+        // through the same handler: every one of them can change what the row
+        // shows, and none of them fires often enough to be worth splitting.
+        var surface: ?*Surface = null;
+        var handlers: [4]c_ulong = @splat(0);
+        if (pageSurface(page)) |s| {
+            surface = s;
+            inline for (.{ "pwd", "title", "bell-ringing", "readonly" }, 0..) |detail, i| {
+                handlers[i] = gobject.Object.signals.notify.connect(
+                    s,
+                    *Self,
+                    &surfaceChanged,
+                    self,
+                    .{ .detail = detail },
+                );
+            }
+        }
+
+        const priv = self.private();
+        priv.rows.append(Application.default().allocator(), .{
+            .page = page,
+            .box = box,
+            .text_box = text_box,
+            .label = label,
+            .icon = icon,
+            .close = close,
+            .subtitle_box = subtitle_box,
+            .branch_label = branch_label,
+            .subtitle_label = subtitle_label,
+            .indicator_box = indicator_box,
+            .bell_icon = bell_icon,
+            .readonly_icon = readonly_icon,
+            .surface = surface,
+            .handlers = handlers,
+        }) catch return;
+
+        self.watchBranch(&priv.rows.items[priv.rows.items.len - 1]);
+
+        // A row realized mid-slide joins whatever state the others are in.
+        const vis: c_int = @intFromBool(priv.content_shown);
+        text_box.as(gtk.Widget).setVisible(vis);
+        close.as(gtk.Widget).setVisible(vis);
+
+        self.refreshNames();
+        self.applyRowContent(&priv.rows.items[priv.rows.items.len - 1]);
+        self.applyRailInsets();
+    }
+
+    fn rowUnbind(
+        _: *gtk.SignalListItemFactory,
+        object: *gobject.Object,
+        self: *Self,
+    ) callconv(.c) void {
+        const list_item = gobject.ext.cast(gtk.ListItem, object) orelse return;
+        const obj = list_item.as(gobject.Object);
+
+        const box = gobject.Object.getData(obj, key_row_box) orelse return;
+        const priv = self.private();
+        for (priv.rows.items, 0..) |*row, i| {
+            if (@intFromPtr(row.box) == @intFromPtr(box)) {
+                row.deinit(Application.default().allocator());
+                _ = priv.rows.swapRemove(i);
+                break;
+            }
+        }
+
+        // Drop the page pointers so a recycled row can never act on the tab
+        // it used to be showing.
+        if (gobject.Object.getData(obj, key_close_button)) |ptr| {
+            const c: *gtk.Button = @ptrCast(@alignCast(ptr));
+            gobject.Object.setData(c.as(gobject.Object), key_page, null);
+        }
+        if (gobject.Object.getData(obj, key_row_box)) |ptr| {
+            const b: *gtk.Box = @ptrCast(@alignCast(ptr));
+            gobject.Object.setData(b.as(gobject.Object), key_page, null);
+        }
+    }
+
+    //---------------------------------------------------------------
+    // Signal Handlers
+
+    fn surfaceChanged(
+        surface: *Surface,
+        pspec: *gobject.ParamSpec,
+        self: *Self,
+    ) callconv(.c) void {
+        // A cd can move a tab into a different repository, so the branch
+        // watch has to be repointed before the row is redrawn. Only for pwd:
+        // a title or a bell cannot change which repository a tab is in.
+        if (std.mem.eql(u8, std.mem.span(pspec.f_name orelse ""), "pwd")) {
+            for (self.private().rows.items) |*row| {
+                if (row.surface == surface) self.watchBranch(row);
+            }
+        }
+
+        // One tab's cd can change another tab's label, by creating or
+        // resolving a name collision, so recompute all of them.
+        self.refreshNames();
+        self.refreshContent();
+    }
+
+    fn closePageData(self: *Self, obj: *gobject.Object) void {
+        const tab_view = self.private().tab_view orelse return;
+        const ptr = gobject.Object.getData(obj, key_page) orelse return;
+        const page: *adw.TabPage = @ptrCast(@alignCast(ptr));
+
+        // Go through closePage so close confirmation and the window's
+        // existing close-page handler still run.
+        tab_view.closePage(page);
+    }
+
+    fn rowCloseClicked(button: *gtk.Button, self: *Self) callconv(.c) void {
+        self.closePageData(button.as(gobject.Object));
+    }
+
+    fn rowMiddleClick(
+        gesture: *gtk.GestureClick,
+        _: c_int,
+        _: f64,
+        _: f64,
+        self: *Self,
+    ) callconv(.c) void {
+        const widget = gesture.as(gtk.EventController).getWidget() orelse return;
+        self.closePageData(widget.as(gobject.Object));
+    }
+
+    fn newTabClicked(_: *gtk.Button, self: *Self) callconv(.c) void {
+        _ = gtk.Widget.activateAction(self.as(gtk.Widget), "win.new-tab", null);
+    }
+
+    const C = Common(Self, Private);
+    pub const as = C.as;
+    pub const ref = C.ref;
+    pub const refSink = C.refSink;
+    pub const unref = C.unref;
+    const private = C.private;
+
